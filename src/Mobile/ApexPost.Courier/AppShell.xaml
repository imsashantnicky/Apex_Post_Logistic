<?xml version="1.0" encoding="UTF-8" ?>
<!-- Routes: //login (sign-in, no tabs) and //main with the tabs scan, pending and sync. ShellNavigator switches
     between them; the pages come from dependency injection. -->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ApexPost.Courier.Views"
       x:Class="ApexPost.Courier.AppShell"
       Title="ApexPost Courier"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="login"
                  Title="Sign in"
                  ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar Route="main">
        <ShellContent Route="scan"
                      Title="New Scan"
                      ContentTemplate="{DataTemplate views:NewScanPage}" />
        <ShellContent Route="pending"
                      Title="Pending"
                      ContentTemplate="{DataTemplate views:PendingScansPage}" />
        <ShellContent Route="sync"
                      Title="Sync Status"
                      ContentTemplate="{DataTemplate views:SyncStatusPage}" />
    </TabBar>

</Shell>
