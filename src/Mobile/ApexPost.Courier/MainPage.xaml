<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ApexPost.Courier.MainPage"
             Title="ApexPost Courier">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Border x:Name="OfflineBanner"
                    IsVisible="False"
                    Padding="12"
                    BackgroundColor="#FDECEA"
                    Stroke="#B3261E"
                    StrokeShape="RoundRectangle 10">
                <Label Text="Server unavailable – working offline. Scans are still saved on this device."
                       TextColor="#B3261E"
                       FontAttributes="Bold"
                       SemanticProperties.Description="Server unavailable, working offline" />
            </Border>

            <Label x:Name="ApiAddressLabel" FontSize="12" TextColor="{StaticResource Gray500}" />
            <HorizontalStackLayout Spacing="12">
                <Label x:Name="CourierLabel" FontSize="14" VerticalOptions="Center" />
                <Button Text="Sign out" Clicked="OnSignOutClicked" />
            </HorizontalStackLayout>

            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="PendingLabel" FontSize="16" FontAttributes="Bold"
                           Text="Pending scans on this device: –" />
                    <Button x:Name="SyncButton" Text="Sync now" Clicked="OnSyncClicked" />
                    <Label x:Name="SyncStatusLabel" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Record a scan" FontAttributes="Bold" />
                    <Label Text="Saved on this device first, then uploaded. Delivered scans need a signature field the app does not have yet."
                           FontSize="12" TextColor="{StaticResource Gray500}" />
                    <Entry x:Name="ScanTrackingEntry"
                           Placeholder="APX-20000001"
                           MaxLength="12"
                           SemanticProperties.Description="Tracking number of the scan" />
                    <Picker x:Name="ScanTypePicker" Title="Scan type" SemanticProperties.Description="Scan type" />
                    <Entry x:Name="LocationEntry" Placeholder="Location, for example Central Hub"
                           SemanticProperties.Description="Location" />
                    <Entry x:Name="NotesEntry" Placeholder="Notes (optional)" SemanticProperties.Description="Notes" />
                    <Button Text="Save scan" Clicked="OnSaveScanClicked" />
                    <Label x:Name="ScanStatusLabel" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Find a shipment" FontAttributes="Bold" />
                    <Entry x:Name="TrackingEntry"
                           Placeholder="APX-20000001"
                           MaxLength="12"
                           SemanticProperties.Description="Tracking number" />
                    <Button x:Name="LookupButton" Text="Look up" Clicked="OnLookupClicked" />
                    <ActivityIndicator x:Name="Busy" IsVisible="False" IsRunning="False" />
                    <Label x:Name="ResultLabel" FontSize="14" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
