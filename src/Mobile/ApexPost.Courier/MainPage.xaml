<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ApexPost.Courier.MainPage"
             Title="ApexPost Courier">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label x:Name="ApiAddressLabel" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Label x:Name="PendingLabel" FontSize="16" FontAttributes="Bold" Text="Pending scans on this device: –" />

            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Access token" FontAttributes="Bold" />
                    <Entry x:Name="TokenEntry"
                           IsPassword="True"
                           Placeholder="Paste a Courier token"
                           SemanticProperties.Description="Access token" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Save token" Clicked="OnSaveTokenClicked" />
                        <Button Text="Sign out" Clicked="OnSignOutClicked" />
                    </HorizontalStackLayout>
                    <Label x:Name="TokenStatusLabel" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Find a shipment" FontAttributes="Bold" />
                    <Entry x:Name="TrackingEntry"
                           Placeholder="APX-20000001"
                           MaxLength="12"
                           SemanticProperties.Description="Tracking number" />
                    <Button x:Name="LookupButton" Text="Look up" Clicked="OnLookupClicked" />
                    <ActivityIndicator x:Name="Busy" IsVisible="False" IsRunning="False" />
                    <Label x:Name="ResultLabel" FontSize="14" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
