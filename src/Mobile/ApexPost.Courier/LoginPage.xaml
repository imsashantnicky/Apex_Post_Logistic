<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ApexPost.Courier.LoginPage"
             Title="Sign in">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="480">

            <Label Text="ApexPost Courier" FontSize="24" FontAttributes="Bold" TextColor="#C8102E" />
            <Label x:Name="ApiAddressLabel" FontSize="12" TextColor="{StaticResource Gray500}" />
            <Label x:Name="StatusLabel" FontSize="14" />

            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Sign in as a demo courier" FontAttributes="Bold" />
                    <Label Text="Works while the API runs in Development (fictional couriers CR-101 and CR-102)."
                           FontSize="12" TextColor="{StaticResource Gray500}" />
                    <Entry x:Name="CourierEntry"
                           Text="CR-101"
                           MaxLength="6"
                           SemanticProperties.Description="Courier id" />
                    <Button x:Name="SignInButton" Text="Sign in" Clicked="OnSignInClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Or paste an access token" FontAttributes="Bold" />
                    <Entry x:Name="TokenEntry"
                           IsPassword="True"
                           Placeholder="Courier token (JWT)"
                           SemanticProperties.Description="Access token" />
                    <Button Text="Use token" Clicked="OnUseTokenClicked" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
