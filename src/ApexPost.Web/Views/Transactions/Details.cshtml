@model CounterPage
@{
    ViewData["Title"] = "Transaction";
    var transaction = Model.Transaction;
    var opened = $"{transaction.Id} · {transaction.Branch} · opened {transaction.OpenedAt:yyyy-MM-dd HH:mm}";
}
<partial name="_PageHeader" model='new PageHeader("Transaction", opened, Model.Help, transaction.Status.ToString())' />

<partial name="_Basket" model="Model" />

@if (Model.BranchClosed)
{
    <p class="alert alert-warn">This branch is closed. The basket takes no more work; a manager can void it.</p>
}
else if (Model.CanWork)
{
    <div class="three-up">
        <partial name="_AddRetailForm" model="Model" />
        <partial name="_AddShippingForm" model="Model" />
        <partial name="_AddMoneyOrderForm" model="Model" />
    </div>
    <div class="split">
        <partial name="_VerifyIdentityForm" model="Model" />
        <partial name="_PaymentForm" model="Model" />
    </div>
}

@if (transaction.Status != TransactionStatus.Open && transaction.Verification is not null)
{
    <p class="fact">Identity: @transaction.Verification</p>
}
@if (transaction.ReversalReason is not null)
{
    <p class="fact">Reversal reason: @transaction.ReversalReason</p>
}

@if (Model.CanVoid || Model.CanRefund)
{
    <div class="split">
        @if (Model.CanVoid)
        {
            <partial name="_ReversalForm" model='new ReversalForm("Void", "Void transaction", transaction.Id)' />
        }
        @if (Model.CanRefund)
        {
            <partial name="_ReversalForm" model='new ReversalForm("Refund", "Refund transaction", transaction.Id)' />
        }
    </div>
}
