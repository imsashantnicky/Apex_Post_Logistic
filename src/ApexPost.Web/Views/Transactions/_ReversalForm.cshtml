@model ReversalForm
<section class="card">
    <details open="@(TempData.FieldError(Model.Action, "Reason") is not null)">
        <summary class="button button-outline">@Model.Title</summary>
        <form asp-action="@Model.Action" asp-route-id="@Model.TransactionId" method="post" class="form"
              data-confirm="@Model.Title? This cannot be undone.">
            <div class="field">
                <label for="@Model.ReasonId">Reason</label>
                <textarea apex-form="@Model.Action"
                          id="@Model.ReasonId" name="Reason" rows="3" maxlength="@TextLimits.Reason"
                          required></textarea>
            </div>
            <button type="submit" class="button button-outline">Confirm</button>
        </form>
    </details>
</section>
