@model CounterPage
@{
    var transaction = Model.Transaction;
}
<section class="card">
    <div class="card-head">
        <h2><partial name="_Icon" model='"id"' />Identity verification</h2>
    </div>
    @if (Model.NeedsVerification)
    {
        <p class="alert alert-warn">This basket needs a passed identity verification before payment.</p>
    }
    @if (transaction.VerificationResult is { } result)
    {
        <p class="fact">Identity: @transaction.Verification <partial name="_StatusPill" model="result.ToString()" /></p>
    }
    <form asp-action="VerifyIdentity" asp-route-id="@transaction.Id" method="post" class="form" autocomplete="off">
        <div class="field">
            <label for="DocumentType">Document type</label>
            <select apex-form="VerifyIdentity"
                    id="DocumentType" name="DocumentType" asp-items="EnumText.Options<DocumentType>()"></select>
        </div>
        <div class="field">
            <label for="DocumentNumber">Document number</label>
            <input apex-form="VerifyIdentity"
                   id="DocumentNumber" name="DocumentNumber" minlength="6" maxlength="20" autocomplete="off" required />
            <span class="hint">Only the last 4 characters are stored.</span>
        </div>
        <button type="submit" class="button button-secondary">Verify identity</button>
    </form>
</section>
