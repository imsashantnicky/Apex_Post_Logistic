@model TransactionListPage
@{
    ViewData["Title"] = "Transactions";
    var result = Model.Result;
    var header = new PageHeader("Transactions", Help: "Open a row to see its basket, payment and reversal.");
}
<partial name="_PageHeader" model="header" />

<form method="get" class="toolbar">
    <partial name="_BranchFilter" model="Model.Filter" />
    <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
            <option value="">All statuses</option>
            @foreach (var option in EnumText.Options<TransactionStatus>())
            {
                <option value="@option.Value" selected="@(option.Value == Model.Status?.ToString())">
                    @option.Text
                </option>
            }
        </select>
    </div>
    <button type="submit" class="button button-secondary">Filter</button>
    @if (Model.CanTransact)
    {
        <a class="button toolbar-end" asp-action="New"><partial name="_Icon" model='"plus"' />New transaction</a>
    }
</form>

<section class="card">
    @if (result.Items.Count == 0)
    {
        <partial name="_EmptyState" model='"No transaction matches this filter."' />
    }
    else
    {
        <div class="table-wrap" tabindex="0" role="region" aria-label="Table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Opened</th>
                        <th scope="col">Branch</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="num">Lines</th>
                        <th scope="col" class="num">Total</th>
                        <th scope="col"><span class="sr-only">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in result.Items)
                    {
                        <tr>
                            <td class="nowrap">@row.OpenedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@row.Branch</td>
                            <td><partial name="_StatusPill" model="row.Status.ToString()" /></td>
                            <td class="num">@row.LineCount</td>
                            <td class="num cell-strong"><partial name="_Money" model="row.Total" /></td>
                            <td class="num">
                                <a class="row-link" asp-action="Details" asp-route-id="@row.Id">
                                    Open<partial name="_Icon" model='"arrow"' />
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav class="pager" aria-label="Pages">
            @if (result.HasPrevious)
            {
                <a asp-action="Index" asp-route-page="@(result.Page - 1)" asp-route-status="@Model.Status"
                   asp-route-branch="@Model.Filter.Selected">Previous</a>
            }
            <span class="muted">Page @result.Page of @result.TotalPages</span>
            @if (result.HasNext)
            {
                <a asp-action="Index" asp-route-page="@(result.Page + 1)" asp-route-status="@Model.Status"
                   asp-route-branch="@Model.Filter.Selected">Next</a>
            }
        </nav>
    }
</section>
