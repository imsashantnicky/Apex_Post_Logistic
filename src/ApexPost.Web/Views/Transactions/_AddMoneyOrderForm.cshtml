@model CounterPage
<section class="card">
    <h2>Add money order</h2>
    <p class="help">
        Amounts above @Model.VerificationThreshold.Amount.ToString("0.00") need a passed identity verification.
    </p>
    <form asp-action="AddMoneyOrder" asp-route-id="@Model.Transaction.Id" method="post" class="form">
        <div class="field">
            <label for="Amount">Amount</label>
            <input id="Amount" name="Amount" type="number" min="0.01" step="0.01" required />
        </div>
        <div class="field">
            <label for="Sender">Sender</label>
            <input id="Sender" name="Sender" maxlength="@TextLimits.Name" required />
        </div>
        <div class="field">
            <label for="Recipient">Recipient</label>
            <input id="Recipient" name="Recipient" maxlength="@TextLimits.Name" required />
        </div>
        <button type="submit" class="button">Add money order</button>
    </form>
</section>
