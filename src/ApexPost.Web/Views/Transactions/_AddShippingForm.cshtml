@using ApexPost.Domain.Shipping
@model CounterPage
@{
    var types = EnumText.Options<ShipmentType>(TempData.FieldValue("AddShipping", "Type"));
    var levels = EnumText.Options<ServiceLevel>(TempData.FieldValue("AddShipping", "Level"));
    var chosenZone = TempData.FieldValue("AddShipping", "ZoneCode");
}
<section class="card">
    <div class="card-head">
        <h2><partial name="_Icon" model='"truck"' />Add shipping</h2>
    </div>
    <form asp-action="AddShipping" asp-route-id="@Model.Transaction.Id" method="post" class="form">
        <fieldset class="form-section">
            <legend>Parcel</legend>
            <div class="field-row">
                <div class="field">
                    <label for="Type">Type</label>
                    <select apex-form="AddShipping" id="Type" name="Type" asp-items="@types"></select>
                </div>
                <div class="field">
                    <label for="Level">Service level</label>
                    <select apex-form="AddShipping" id="Level" name="Level" asp-items="@levels"></select>
                </div>
            </div>
            <div class="field-row">
                <div class="field">
                    <label for="WeightKg">Weight (kg)</label>
                    <input apex-form="AddShipping"
                           id="WeightKg" name="WeightKg" type="number" min="0.001" step="0.001" required />
                </div>
                <div class="field">
                    <label for="ZoneCode">Zone</label>
                    <select apex-form="AddShipping" id="ZoneCode" name="ZoneCode" required>
                        @foreach (var zone in Model.Zones)
                        {
                            <option value="@zone.Code" selected="@(zone.Code == chosenZone)">
                                @zone.Code @zone.Name
                            </option>
                        }
                    </select>
                </div>
            </div>
            <fieldset class="field-row">
                <legend>Dimensions (cm)</legend>
                <div class="field">
                    <label for="LengthCm">Length</label>
                    <input apex-form="AddShipping"
                           id="LengthCm" name="LengthCm" type="number" min="0.1" step="0.1" required />
                </div>
                <div class="field">
                    <label for="WidthCm">Width</label>
                    <input apex-form="AddShipping"
                           id="WidthCm" name="WidthCm" type="number" min="0.1" step="0.1" required />
                </div>
                <div class="field">
                    <label for="HeightCm">Height</label>
                    <input apex-form="AddShipping"
                           id="HeightCm" name="HeightCm" type="number" min="0.1" step="0.1" required />
                </div>
            </fieldset>
        </fieldset>
        <fieldset class="form-section">
            <legend>Recipient</legend>
            <div class="field">
                <label for="RecipientName">Name</label>
                <input apex-form="AddShipping"
                       id="RecipientName" name="RecipientName" maxlength="@TextLimits.Name" required />
            </div>
            <div class="field">
                <label for="Street">Street</label>
                <input apex-form="AddShipping"
                       id="Street" name="Street" maxlength="@TextLimits.AddressLine" required />
            </div>
            <div class="field-row">
                <div class="field">
                    <label for="City">City</label>
                    <input apex-form="AddShipping" id="City" name="City" maxlength="@TextLimits.Name" required />
                </div>
                <div class="field">
                    <label for="PostalCode">Postal code</label>
                    <input apex-form="AddShipping"
                           id="PostalCode" name="PostalCode" maxlength="@TextLimits.PostalCode" required />
                </div>
            </div>
            <div class="field">
                <label for="Country">Country</label>
                <input apex-form="AddShipping" id="Country" name="Country" maxlength="@TextLimits.Name" required />
            </div>
        </fieldset>
        <button type="submit" class="button">Add shipment</button>
    </form>
</section>
