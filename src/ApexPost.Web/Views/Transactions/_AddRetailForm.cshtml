@model CounterPage
<section class="card">
    <div class="card-head">
        <h2><partial name="_Icon" model='"box"' />Add retail item</h2>
    </div>
    <form asp-action="AddRetail" asp-route-id="@Model.Transaction.Id" method="post" class="form">
        <div class="field">
            <label for="Sku">Product</label>
            <select apex-form="AddRetail" id="Sku" name="Sku" required>
                @foreach (var item in Model.Products)
                {
                    <option value="@item.Sku" selected="@(item.Sku.Value == TempData.FieldValue("AddRetail", "Sku"))">
                        @item.Sku @item.Name (@item.UnitPrice, @item.InStock in stock)
                    </option>
                }
            </select>
        </div>
        <div class="field">
            <label for="Quantity">Quantity</label>
            <input apex-form="AddRetail"
                   id="Quantity" name="Quantity" type="number" min="1" step="1" value="1" required />
        </div>
        <button type="submit" class="button">Add item</button>
    </form>
</section>
