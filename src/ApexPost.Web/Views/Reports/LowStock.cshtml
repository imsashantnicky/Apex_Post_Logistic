@model ReportPage<LowStockReport>
@{
    ViewData["Title"] = "Low stock";
    var report = Model.Report;
    var header = new PageHeader(
        "Low stock",
        Model.Toolbar.Subtitle,
        $"Stock today, lowest first: items with {report.Threshold} or fewer left.");
}
<partial name="_PageHeader" model="header" />
<partial name="_ReportFilter" model="Model.Toolbar" />

<section class="card">
    @if (report.Rows.Count == 0)
    {
        <partial name="_EmptyState" model='"No item is at or below the threshold."' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Branch</th>
                        <th scope="col">SKU</th>
                        <th scope="col">Product</th>
                        <th scope="col" class="num">In stock</th>
                        <th scope="col" class="num">Threshold</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in report.Rows)
                    {
                        <tr>
                            <td>@row.Branch</td>
                            <td>@row.Sku</td>
                            <td>@row.Product</td>
                            <td class="num">@row.Quantity</td>
                            <td class="num">@report.Threshold</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
