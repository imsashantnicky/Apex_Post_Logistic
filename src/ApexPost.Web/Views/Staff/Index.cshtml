@model IReadOnlyList<StaffSummary>
@{
    ViewData["Title"] = "Staff";
    var header = new PageHeader("Staff", Help: "Add staff, change their details and manage their access.");
}
<partial name="_PageHeader" model="header" />

<div class="actions">
    <a class="button" asp-action="Create"><partial name="_Icon" model='"plus"' />Add staff</a>
</div>

<section class="card">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model='"No staff yet."' />
    }
    else
    {
        <div class="table-wrap" tabindex="0" role="region" aria-label="Table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Role</th>
                        <th scope="col">Branch</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="sr-only">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td class="cell-strong">@member.Name</td>
                            <td>@member.Email</td>
                            <td><span class="tag">@EnumText.Label(member.Role)</span></td>
                            <td class="code">@member.HomeBranch</td>
                            <td><partial name="_StatusPill" model='member.IsActive ? "Active" : "Inactive"' /></td>
                            <td class="num">
                                <a class="row-link" asp-action="Edit" asp-route-id="@member.Id">
                                    Open<partial name="_Icon" model='"arrow"' />
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
