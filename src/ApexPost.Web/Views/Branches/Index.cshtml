@model IReadOnlyList<BranchSummary>
@{
    ViewData["Title"] = "Branches";
    var header = new PageHeader("Branches", Help: "Open or close a branch and manage its counters.");
}
<partial name="_PageHeader" model="header" />

<section class="card">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model='"No branches yet."' />
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Code</th>
                        <th scope="col">Name</th>
                        <th scope="col">Region</th>
                        <th scope="col">Hours</th>
                        <th scope="col" class="num">Counters</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="sr-only">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var branch in Model)
                    {
                        <tr>
                            <td>@branch.Code</td>
                            <td>@branch.Name</td>
                            <td>@branch.Region</td>
                            <td>@branch.OpensAt.ToString("HH:mm")–@branch.ClosesAt.ToString("HH:mm")</td>
                            <td class="num">@branch.Counters.Count</td>
                            <td><partial name="_StatusPill" model='branch.IsActive ? "Open" : "Closed"' /></td>
                            <td><a asp-action="Details" asp-route-id="@branch.Code.Value">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
