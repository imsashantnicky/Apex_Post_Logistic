@model BranchSummary
@{
    ViewData["Title"] = Model.Name;
    var code = Model.Code.Value;
    var header = new PageHeader(
        Model.Name,
        $"{code} · {Model.Region} · {Model.OpensAt:HH:mm}–{Model.ClosesAt:HH:mm}",
        "A closed branch takes no new work; managers can still void open baskets and refund sales.",
        Model.IsActive ? "Open" : "Closed");
}
<partial name="_PageHeader" model="header" />

<div class="split">
    <section class="card">
        <div class="card-head">
            <h2><partial name="_Icon" model='"receipt"' />Counters</h2>
            <span class="tag">@Model.Counters.Count</span>
        </div>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Counter</th>
                        <th scope="col"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var counter in Model.Counters)
                    {
                        <tr>
                            <td class="cell-strong">Counter @counter.Number</td>
                            <td class="num">
                                @if (Model.Counters.Count > 1)
                                {
                                    <form asp-action="RemoveCounter" asp-route-id="@code" method="post"
                                          class="inline-form" data-confirm="Remove counter @counter.Number?">
                                        <input type="hidden" name="counterId" value="@counter.Id" />
                                        <input type="hidden" name="version" value="@Model.Version" />
                                        <button type="submit" class="button button-outline button-small">
                                            Remove<span class="sr-only"> counter @counter.Number</span>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <form asp-action="AddCounter" asp-route-id="@code" method="post" class="more">
            <input type="hidden" name="version" value="@Model.Version" />
            <button type="submit" class="button button-secondary">
                <partial name="_Icon" model='"plus"' />Add counter
            </button>
        </form>
    </section>
    <section class="card card-accent">
        <div class="card-head">
            <h2><partial name="_Icon" model='"building"' />Status</h2>
        </div>
        @if (Model.IsActive)
        {
            <p class="help">Closing stops all counter work at this branch until it is reopened.</p>
            <form asp-action="Close" asp-route-id="@code" method="post" class="form"
                  data-confirm="Close @Model.Name? Its clerks can no longer work on any basket.">
                <input type="hidden" name="version" value="@Model.Version" />
                <button type="submit" class="button button-outline">Close branch</button>
            </form>
        }
        else
        {
            <p class="help">The branch is closed. Reopening lets its clerks work again.</p>
            <form asp-action="Reopen" asp-route-id="@code" method="post" class="form">
                <input type="hidden" name="version" value="@Model.Version" />
                <button type="submit" class="button">Reopen branch</button>
            </form>
        }
    </section>
</div>
