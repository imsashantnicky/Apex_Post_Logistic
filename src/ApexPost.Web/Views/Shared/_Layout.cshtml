@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var canTransact = isSignedIn && (await Authorization.AuthorizeAsync(User, ApexPolicies.CanTransact)).Succeeded;
    var canViewReports = isSignedIn
        && (await Authorization.AuthorizeAsync(User, ApexPolicies.CanViewReports)).Succeeded;
    var canAdminister = isSignedIn
        && (await Authorization.AuthorizeAsync(User, ApexPolicies.AdministratorOnly)).Succeeded;
    var canReadAudit = isSignedIn && (await Authorization.AuthorizeAsync(User, ApexPolicies.AuditViewers)).Succeeded;
    var role = User.Role is { } staffRole ? EnumText.Label(staffRole) : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · ApexPost Counter</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Dashboard" asp-action="Index">ApexPost Counter</a>
        @if (isSignedIn)
        {
            <nav class="nav" aria-label="Main">
                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-controller="Catalogue" asp-action="Index">Catalogue</a>
                <a asp-controller="Transactions" asp-action="Index">Transactions</a>
                @if (canTransact)
                {
                    <a asp-controller="Transactions" asp-action="New">New transaction</a>
                }
                <a asp-controller="Notifications" asp-action="Index">Notifications</a>
                @if (canViewReports)
                {
                    <a asp-controller="Reports" asp-action="Index">Reports</a>
                }
                @if (canAdminister)
                {
                    <a asp-controller="Staff" asp-action="Index">Staff</a>
                    <a asp-controller="Branches" asp-action="Index">Branches</a>
                }
                @if (canReadAudit)
                {
                    <a asp-controller="Audit" asp-action="Index">Audit</a>
                }
            </nav>
            <div class="who">
                <span>@User.Identity?.Name · @role · @User.BranchCode</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="link-button">Sign out</button>
                </form>
            </div>
        }
    </header>
    <main class="content">
        <partial name="_Flash" />
        @RenderBody()
    </main>
    <footer class="footer">
        ApexPost Counter Platform · Week 2 · Correlation ID @Context.TraceIdentifier
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
