@model ReportToolbar
@if (Model.Branches.Choices.Count > 0 || Model.From is not null)
{
    <form method="get" class="toolbar">
        <partial name="_BranchFilter" model="Model.Branches" />
        @if (Model.From is not null)
        {
            <div class="field">
                <label for="from">From</label>
                <input id="from" name="from" type="date" value="@Model.FromText" />
            </div>
            <div class="field">
                <label for="to">To</label>
                <input id="to" name="to" type="date" value="@Model.ToText" />
            </div>
        }
        <button type="submit" class="button button-secondary">Show</button>
    </form>
}
