@model StatusPage
@{
    ViewData["Title"] = Model.Title;
}
<div class="centre-card card">
    <h1 class="brand-title">@Model.Status – @Model.Title</h1>
    <p>@Model.Detail</p>
    <p class="trace">Trace ID: @Model.TraceId</p>
    <p class="trace">Correlation ID: @Model.CorrelationId</p>
    @if (Model.Stack is not null)
    {
        <pre class="stack">@Model.Stack</pre>
    }
    <a class="button" asp-controller="Dashboard" asp-action="Index">Back to the start</a>
</div>
