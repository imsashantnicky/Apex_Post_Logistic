@model PageHeader
@inject ApexPost.Application.Abstractions.IClock Clock
@inject ApexPost.Application.Services.BranchService Branches
@{
    var subtitle = Model.Subtitle;
    if (subtitle is null)
    {
        var branch = await Branches.GetAsync(User.BranchCode!, Context.RequestAborted);
        subtitle = $"{branch.Name} ({branch.Code}) · {Clock.Today:yyyy-MM-dd}";
    }
}
<div class="page-header">
    <h1>@Model.Title @if (Model.Status is not null) { <partial name="_StatusPill" model="Model.Status" /> }</h1>
    <p class="muted">@subtitle</p>
    @if (Model.Help is not null)
    {
        <p class="help">@Model.Help</p>
    }
</div>
