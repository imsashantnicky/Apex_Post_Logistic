{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataFolder": "data"
  },
  "Seed": {
    "Enabled": false
  },
  "Passwords": {
    "Iterations": 600000,
    "MinimumLength": 12
  },
  "Tax": {
    "StandardPercent": 20,
    "ReducedPercent": 5,
    "ExemptPercent": 0
  },
  "MoneyOrders": {
    "IdentityVerificationThreshold": 300,
    "HighValueAlertAmount": 1000
  },
  "Stock": {
    "LowStockThreshold": 5
  },
  "Shipping": {
    "StandardMultiplier": 1.0,
    "ExpressMultiplier": 1.6,
    "RegisteredMultiplier": 1.3
  },
  "Courier": {
    "TimeoutMilliseconds": 2000,
    "MaxConcurrentRequests": 3
  },
  "Catalog": {
    "CacheSeconds": 300
  }
}
