{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataFolder": "data"
  },
  "Seed": {
    "Enabled": false
  },
  "Passwords": {
    "Iterations": 600000,
    "MinimumLength": 12
  },
  "Tax": {
    "StandardPercent": 20,
    "ReducedPercent": 5,
    "ExemptPercent": 0
  },
  "MoneyOrders": {
    "IdentityVerificationThreshold": 300,
    "HighValueAlertAmount": 1000
  },
  "Stock": {
    "LowStockThreshold": 5
  },
  "Shipping": {
    "StandardMultiplier": 1.0,
    "ExpressMultiplier": 1.6,
    "RegisteredMultiplier": 1.3
  },
  "Courier": {
    "TimeoutMilliseconds": 2000,
    "MaxConcurrentRequests": 3
  },
  "Catalog": {
    "CacheSeconds": 300
  },
  "Performance": {
    "SlowActionMs": 500
  },
  "Maintenance": {
    "Enabled": false,
    "RetryAfterSeconds": 120
  },
  "Security": {
    "AdminAllowedIps": [ "127.0.0.1", "::1" ],
    "IntegrationAllowedIps": [ "127.0.0.1", "::1" ]
  },
  "Integration": {
    "AllowedOrigins": [ "https://tracking.partner.example" ]
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 5,
    "PartnerPermitsPerMinute": 30
  }
}
