<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The same user-secrets store as ApexPost.Web: ConnectionStrings:ApexPostDb is set once for both hosts. -->
    <!-- XML comments feed the OpenAPI document; with warnings as errors every public member must be documented. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>8ee05317-5b65-4866-a83b-e9e701628c18</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Application\ApexPost.Application.csproj" />
    <ProjectReference Include="..\ApexPost.Infrastructure\ApexPost.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

</Project>
