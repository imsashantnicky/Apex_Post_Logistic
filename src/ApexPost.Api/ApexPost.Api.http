###############################################################################
# v2 PATCH /api/v2/shipments/{trackingNumber}/status - move forward
# v2 sends the status as a string: Created, PickedUp, InTransit, OutForDelivery, Delivered, Failed.
###############################################################################

### v2 200 - Created -> OutForDelivery (skipping stages forward is allowed)
PATCH {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/status
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{ "status": "OutForDelivery" }

### v2 400 - unknown status name
PATCH {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/status
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{ "status": "Lost" }

### v2 404 - unknown tracking number
PATCH {{v2}}/{{unknownShipment}}/status
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{ "status": "PickedUp" }

### v2 409 - PickedUp cannot go back to Created
PATCH {{v2}}/{{pickedUpShipment}}/status
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{ "status": "Created" }

### v2 409 - Delivered is final
PATCH {{v2}}/{{deliveredShipment}}/status
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{ "status": "Failed" }

### v2 415 - wrong content type
PATCH {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/status
Authorization: Bearer {{courierToken}}
Content-Type: text/plain
Accept: {{json}}

status=PickedUp

###############################################################################
# v2 POST /api/v2/shipments/{trackingNumber}/scans - idempotent scan upload
# scanType as a string: Pickup, InTransit, Delivered, Failed. Same answer shape as v1.
###############################################################################

### v2 200 - a scan of a seeded InTransit shipment: accepted 1 on the first run, duplicatesSkipped 1 afterwards
POST {{v2}}/APX-20000005/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "{{repeatedScanIdV2}}",
      "trackingNumber": "APX-20000005",
      "scanType": "InTransit",
      "courierId": "CR-101",
      "location": "Southmere hub",
      "scannedAtUtc": "2026-11-01T09:00:00Z",
      "notes": "Second hub scan"
    }
  ]
}

### v2 200 - delivered with a signature: accepted 1, the shipment ends as Delivered; GET it to see latestScan
POST {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{createShipmentV2.response.body.$.trackingNumber}}",
      "scanType": "Delivered",
      "courierId": "CR-101",
      "location": "8 Harbour Lane",
      "scannedAtUtc": "2026-11-01T15:00:00Z",
      "recipientSignatureName": "N. Example"
    }
  ]
}

### v2 400 - Delivered scan without recipientSignatureName, scan id not scan::{Guid}, courier id not CR-###
POST {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "123",
      "trackingNumber": "{{createShipmentV2.response.body.$.trackingNumber}}",
      "scanType": "Delivered",
      "courierId": "COURIER-1",
      "location": "Doorstep",
      "scannedAtUtc": "2026-11-01T12:00:00Z"
    }
  ]
}

### v2 400 - unknown scanType name
POST {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{createShipmentV2.response.body.$.trackingNumber}}",
      "scanType": "Teleported",
      "courierId": "CR-101",
      "location": "Central hub",
      "scannedAtUtc": "2026-11-01T12:00:00Z"
    }
  ]
}

### v2 404 - unknown shipment
POST {{v2}}/{{unknownShipment}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{unknownShipment}}",
