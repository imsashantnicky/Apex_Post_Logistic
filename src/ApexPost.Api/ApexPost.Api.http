      "courierId": "CR-101",
      "location": "Harbour Point depot",
      "scannedAtUtc": "2026-11-01T08:00:00Z"
    }
  ]
}

### v2 415 - wrong content type
POST {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: text/plain
Accept: {{json}}

scan

###############################################################################
# v2 GET /api/v2/shipments/{trackingNumber}/scans - scan history, oldest first, scanType as a string
###############################################################################

### v2 200 - scans of a seeded InTransit shipment
GET {{v2}}/APX-20000005/scans
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### v2 404 - unknown shipment
GET {{v2}}/{{unknownShipment}}/scans
Authorization: Bearer {{courierToken}}
Accept: {{json}}

###############################################################################
# v2 DELETE /api/v2/shipments/{trackingNumber} - only while Created
###############################################################################

### v2 409 - PickedUp shipments cannot be deleted
DELETE {{v2}}/{{pickedUpShipment}}
Authorization: Bearer {{adminToken}}

### v2 404 - unknown tracking number
DELETE {{v2}}/{{unknownShipment}}
Authorization: Bearer {{adminToken}}

### v2 204 - create a throw-away shipment, then delete it
# @name throwAwayV2
POST {{v2}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-6{{$randomInt 1000000 9999999}}",
  "recipient": {
    "name": "Lee Example",
    "phone": "+44 20 7946 0198",
    "address": "9 Example Road",
    "city": "Westfield"
  },
  "weightKg": 1
}

###
DELETE {{v2}}/{{throwAwayV2.response.body.$.trackingNumber}}
Authorization: Bearer {{adminToken}}
