# v2 (current) - /api/v2/shipments
###############################################################################
###############################################################################

###############################################################################
# v2 GET /api/v2/shipments - list (nested recipient, latestScan, status as a string)
###############################################################################

### v2 200 - first page, default page size 20
GET {{v2}}
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### v2 200 - page 1 of 5, only InTransit shipments in Riverton
GET {{v2}}?page=1&pageSize=5&status=InTransit&city=riverton
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### v2 400 - pageSize above the maximum of 50 (ValidationProblemDetails)
GET {{v2}}?pageSize=51
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### v2 400 - page below 1
GET {{v2}}?page=0
Authorization: Bearer {{courierToken}}
Accept: {{json}}

###############################################################################
# v2 POST /api/v2/shipments - create (nested recipient)
###############################################################################

### v2 201 - created; the Location header points at GET /api/v2/shipments/{trackingNumber}
# A random tracking number, so this request can run again. latestScan is null until the first scan.
# @name createShipmentV2
POST {{v2}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-5{{$randomInt 1000000 9999999}}",
  "recipient": {
    "name": "Noah Example",
    "phone": "+44 20 7946 0197",
    "address": "8 Harbour Lane",
    "city": "Harbour Point"
  },
  "weightKg": 2.5
}

### v2 400 - invalid tracking number, nested recipient errors (Recipient.Name, Recipient.Phone) and weight
POST {{v2}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-123",
  "recipient": {
    "name": "",
    "phone": "call me",
    "address": "8 Harbour Lane",
    "city": "Harbour Point"
  },
  "weightKg": 31
}

### v2 400 - the flat v1 body is not a v2 body: recipient is required
POST {{v2}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-50000001",
  "recipientName": "Kim Example",
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "5 Example Street",
  "recipientCity": "Harbour Point",
  "weightKg": 2.5
}

### v2 409 - the tracking number already exists
POST {{v2}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "{{createdShipment}}",
  "recipient": {
    "name": "Noah Example",
    "phone": "+44 20 7946 0197",
    "address": "8 Harbour Lane",
    "city": "Harbour Point"
  },
  "weightKg": 2.5
}

### v2 415 - the body is not application/json
POST {{v2}}
Authorization: Bearer {{adminToken}}
Content-Type: text/plain
Accept: {{json}}

trackingNumber=APX-50000001

