# ApexPost shipment tracking API - a success and a failure request for every endpoint, in v1 and v2.
# Start the API first: dotnet run --project src/ApexPost.Api --launch-profile https
# Development seeds APX-20000001 ... APX-20000010 (see API-NOTES.md for their statuses).
# Run each version's requests top to bottom: later requests reuse the shipment created by
# "createShipmentV1" / "createShipmentV2". All data is fictional.
#
# v1 (/api/v1/shipments, alias /api/shipments) is deprecated: flat recipient fields, enums as numbers.
# v2 (/api/v2/shipments) is current: nested "recipient", "latestScan", enums as strings.
# Every answer carries api-supported-versions: 2.0 and api-deprecated-versions: 1.0;
# v1 answers also carry Deprecation, Sunset and Link headers (see VERSIONING.md).
#
# Every request needs a bearer token (Part D). Reads accept any role; scan upload and status PATCH need Courier;
# create, replace and DELETE need Admin. Run "courierLogin" below first. For the Admin token run once and paste
# the printed token into @adminToken (never commit a real token; these are local development tokens):
#   dotnet user-jwts create --project src/ApexPost.Api --role Admin
# A Courier token from the same tool also works in place of the /dev/token one:
#   dotnet user-jwts create --project src/ApexPost.Api --role Courier --claim courierId=CR-101

@baseUrl = https://localhost:7310
@v1 = {{baseUrl}}/api/v1/shipments
@v2 = {{baseUrl}}/api/v2/shipments
@v2Partner = {{baseUrl}}/api/v2/partner/shipments
@json = application/json

# Seeded shipments
@createdShipment = APX-20000001
@pickedUpShipment = APX-20000003
@inTransitShipment = APX-20000005
@deliveredShipment = APX-20000008
@unknownShipment = APX-29999999

# Fixed scan ids: the first run stores them, every later run reports them as duplicates.
@repeatedScanIdV1 = scan::0f8fad5b-d9cb-469f-a165-70867728950e
@repeatedScanIdV2 = scan::7c9e6679-7425-40de-944b-e07fc1f90ae7

# Tokens: the courier token comes from the "courierLogin" request; paste the user-jwts Admin token here.
@courierToken = {{courierLogin.response.body.$.accessToken}}
@adminToken = paste-the-output-of-dotnet-user-jwts-create-role-Admin

# Partner key: set one once (never commit it) and paste the same value here:
#   dotnet user-secrets set "PartnerKeys:ParcelTrackDemo" "<a long random value>" --project src/ApexPost.Api
@partnerKey = paste-the-value-of-PartnerKeys-ParcelTrackDemo

# Expired token for the 401 "expired" request: a Courier token whose lifetime ended in the past. Create it once and
# paste it here (the API allows 30 s clock skew, so any end date before today works):
#   dotnet user-jwts create --project src/ApexPost.Api --role Courier --claim courierId=CR-101
#     --not-before 2026-01-01 --expires-on 2026-01-02 --output token
@expiredToken = paste-the-output-of-dotnet-user-jwts-create-with-a-past-expires-on

###############################################################################
# Authentication and roles (Part D)
###############################################################################

### 200 - Development sign-in for the fictional courier CR-101: a one-hour token with role Courier
# @name courierLogin
POST {{baseUrl}}/dev/token
Content-Type: {{json}}

{
  "courierId": "CR-101"
}

### 401 - /dev/token knows only the fictional couriers CR-101 and CR-102
POST {{baseUrl}}/dev/token
Content-Type: {{json}}

{
  "courierId": "CR-999"
}

### 200 - a valid token of any role may read
GET {{v2}}/{{createdShipment}}
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### 401 - no token (ProblemDetails, WWW-Authenticate: Bearer)
GET {{v2}}/{{createdShipment}}
Accept: {{json}}

### 401 - an expired token ("The bearer token has expired. Sign in again for a new token.")
GET {{v2}}/{{createdShipment}}
Authorization: Bearer {{expiredToken}}
Accept: {{json}}

### 401 - a token that is not signed with the API's key ("The bearer token is not valid.")
GET {{v2}}/{{createdShipment}}
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJDUi0xMDEifQ.invalid-signature
Accept: {{json}}

### 200 - a valid Admin token may read as well
GET {{v2}}/{{createdShipment}}
Authorization: Bearer {{adminToken}}
Accept: {{json}}

### 403 - an Admin token cannot upload scans (Courier only; "The role of your token does not allow this action.")
POST {{v2}}/{{pickedUpShipment}}/scans
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{pickedUpShipment}}",
      "scanType": "InTransit",
      "courierId": "CR-101",
      "location": "Central hub",
      "scannedAtUtc": "2026-11-01T10:00:00Z"
    }
  ]
}

### 403 - a Courier token cannot delete (Admin only)
DELETE {{v2}}/{{createdShipment}}
Authorization: Bearer {{courierToken}}

### 403 - a Courier token cannot create a shipment (Admin only)
POST {{v2}}
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}

{
  "trackingNumber": "APX-2{{$randomInt 1000000 9999999}}",
  "recipient": { "name": "Ava Example", "phone": "+44 20 7946 0101", "address": "12 Quay Street", "city": "Harbour Point" },
  "weightKg": 2.5
}

### 403 - courier CR-101 cannot upload a scan recorded by CR-102 (checked in the tracking service)
POST {{v2}}/{{pickedUpShipment}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{pickedUpShipment}}",
      "scanType": "InTransit",
      "courierId": "CR-102",
      "location": "Central hub",
      "scannedAtUtc": "2026-11-01T10:00:00Z"
    }
  ]
}

###############################################################################
# Partner tracking (v2 only, X-Api-Key instead of a user token)
###############################################################################

### 200 - a partner key reads status, destination city and latest scan (no recipient details)
GET {{v2Partner}}/{{inTransitShipment}}
X-Api-Key: {{partnerKey}}
Accept: {{json}}

### 401 - no X-Api-Key header (WWW-Authenticate: ApiKey)
GET {{v2Partner}}/{{inTransitShipment}}
Accept: {{json}}

### 401 - an unknown key ("The API key is not valid."; the key is never echoed or logged)
GET {{v2Partner}}/{{inTransitShipment}}
X-Api-Key: not-a-partner-key
Accept: {{json}}

### 401 - a user token does not open the partner route
GET {{v2Partner}}/{{inTransitShipment}}
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### 404 - a valid key and an unknown tracking number
GET {{v2Partner}}/{{unknownShipment}}
X-Api-Key: {{partnerKey}}
Accept: {{json}}

###############################################################################
# Versioning
###############################################################################

### 200 - the Part B alias /api/shipments is v1 (no version in the URL means 1.0); deprecation headers included
GET {{baseUrl}}/api/shipments/{{createdShipment}}
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### 404 - unknown API version (ProblemDetails)
GET {{baseUrl}}/api/v3/shipments/{{createdShipment}}
Authorization: Bearer {{courierToken}}
Accept: {{json}}

###############################################################################
###############################################################################
# v1 (deprecated) - /api/v1/shipments
###############################################################################
###############################################################################

###############################################################################
# v1 GET /api/v1/shipments - list
###############################################################################

### v1 200 - first page, default page size 20
GET {{v1}}
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### v1 200 - page 1 of 5, only InTransit shipments in Riverton
GET {{v1}}?page=1&pageSize=5&status=InTransit&city=riverton
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### v1 400 - pageSize above the maximum of 50 (ValidationProblemDetails)
GET {{v1}}?pageSize=51
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### v1 400 - unknown status value
GET {{v1}}?status=Lost
Authorization: Bearer {{courierToken}}
Accept: {{json}}

###############################################################################
# v1 POST /api/v1/shipments - create (flat recipient fields)
###############################################################################

### v1 201 - created; the Location header points at GET /api/v1/shipments/{trackingNumber}
# A random tracking number, so this request can run again.
# @name createShipmentV1
POST {{v1}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-3{{$randomInt 1000000 9999999}}",
  "recipientName": "Kim Example",
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "5 Example Street",
  "recipientCity": "Harbour Point",
  "weightKg": 2.5
}

### v1 400 - invalid tracking number, phone and weight (errors per field)
POST {{v1}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-123",
  "recipientName": "",
  "recipientPhone": "call me",
  "recipientAddress": "5 Example Street",
  "recipientCity": "Harbour Point",
  "weightKg": 31
}

### v1 409 - the tracking number already exists
POST {{v1}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "{{createdShipment}}",
  "recipientName": "Kim Example",
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "5 Example Street",
  "recipientCity": "Harbour Point",
  "weightKg": 2.5
}

### v1 415 - the body is not application/json
POST {{v1}}
Authorization: Bearer {{adminToken}}
Content-Type: text/plain
Accept: {{json}}

trackingNumber=APX-30000001

###############################################################################
# v1 GET /api/v1/shipments/{trackingNumber} - read one
###############################################################################

### v1 200 - the shipment just created
GET {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### v1 404 - unknown tracking number
GET {{v1}}/{{unknownShipment}}
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### v1 404 - not APX- + 8 digits, so the route constraint does not match
GET {{v1}}/ABC-1
Authorization: Bearer {{courierToken}}
Accept: {{json}}

###############################################################################
# v1 PUT /api/v1/shipments/{trackingNumber} - replace recipient and weight
###############################################################################

### v1 200 - replaced
PUT {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipientName": "Kim Example",
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "7 Example Street",
  "recipientCity": "Northgate",
  "weightKg": 3
}

### v1 400 - weight below 0.1 kg and name missing
PUT {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "7 Example Street",
  "recipientCity": "Northgate",
  "weightKg": 0
}

### v1 404 - unknown tracking number
PUT {{v1}}/{{unknownShipment}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipientName": "Kim Example",
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "7 Example Street",
  "recipientCity": "Northgate",
  "weightKg": 3
}

### v1 409 - a Delivered shipment can no longer change
PUT {{v1}}/{{deliveredShipment}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipientName": "Hal Specimen",
  "recipientPhone": "+44 20 7946 0108",
  "recipientAddress": "6 Hill Crescent",
  "recipientCity": "Hillcrest",
  "weightKg": 25
}

### v1 415 - wrong content type
PUT {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}
Authorization: Bearer {{adminToken}}
Content-Type: application/xml
Accept: {{json}}

<shipment />

###############################################################################
# v1 PATCH /api/v1/shipments/{trackingNumber}/status - move forward
# v1 sends the status as a number: 1 Created, 2 PickedUp, 3 InTransit, 4 OutForDelivery, 5 Delivered, 6 Failed.
###############################################################################

### v1 400 - status missing
PATCH {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/status
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{}

### v1 404 - unknown tracking number
PATCH {{v1}}/{{unknownShipment}}/status
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{ "status": 2 }

### v1 409 - PickedUp cannot go back to Created
PATCH {{v1}}/{{pickedUpShipment}}/status
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{ "status": 1 }

### v1 409 - Delivered is final
PATCH {{v1}}/{{deliveredShipment}}/status
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{ "status": 6 }

### v1 415 - wrong content type
PATCH {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/status
Authorization: Bearer {{courierToken}}
Content-Type: text/plain
Accept: {{json}}

status=2

###############################################################################
# v1 POST /api/v1/shipments/{trackingNumber}/scans - idempotent scan upload
# scanType as a number: 1 Pickup, 2 InTransit, 3 Delivered, 4 Failed.
# Answer: { accepted, duplicatesSkipped, rejected: [{ scanId, reason }] }
###############################################################################

### v1 200 - first run: accepted 1 (Created -> PickedUp); later runs: duplicatesSkipped 1
POST {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "{{repeatedScanIdV1}}",
      "trackingNumber": "{{createShipmentV1.response.body.$.trackingNumber}}",
      "scanType": 1,
      "courierId": "CR-101",
      "location": "Harbour Point depot",
      "scannedAtUtc": "2026-11-01T08:00:00Z",
      "notes": "Collected at the counter"
    }
  ]
}

### v1 200 - mixed batch: 1 accepted (InTransit), 1 duplicate (repeated scan id), 2 rejected
# (a scan of another shipment, and a later Pickup that would move the status back)
POST {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{createShipmentV1.response.body.$.trackingNumber}}",
      "scanType": 2,
      "courierId": "CR-101",
      "location": "Central hub",
      "scannedAtUtc": "2026-11-01T10:00:00Z"
    },
    {
      "scanId": "{{repeatedScanIdV1}}",
      "trackingNumber": "{{createShipmentV1.response.body.$.trackingNumber}}",
      "scanType": 1,
      "courierId": "CR-101",
      "location": "Harbour Point depot",
      "scannedAtUtc": "2026-11-01T08:00:00Z"
    },
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{createdShipment}}",
      "scanType": 1,
      "courierId": "CR-101",
      "location": "Harbour Point depot",
      "scannedAtUtc": "2026-11-01T10:30:00Z"
    },
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{createShipmentV1.response.body.$.trackingNumber}}",
      "scanType": 1,
      "courierId": "CR-101",
      "location": "Central hub",
      "scannedAtUtc": "2026-11-01T11:00:00Z"
    }
  ]
}

### v1 400 - Delivered scan without recipientSignatureName, scan id not scan::{Guid}, courier id not CR-###
POST {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "123",
      "trackingNumber": "{{createShipmentV1.response.body.$.trackingNumber}}",
      "scanType": 3,
      "courierId": "COURIER-1",
      "location": "Doorstep",
      "scannedAtUtc": "2026-11-01T12:00:00Z"
    }
  ]
}

### v1 400 - empty batch (1 to 100 scans)
POST {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{ "scans": [] }

### v1 404 - unknown shipment
POST {{v1}}/{{unknownShipment}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{unknownShipment}}",
      "scanType": 1,
      "courierId": "CR-101",
      "location": "Harbour Point depot",
      "scannedAtUtc": "2026-11-01T08:00:00Z"
    }
  ]
}

### v1 415 - wrong content type
POST {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: text/plain
Accept: {{json}}

scan

###############################################################################
# v1 GET /api/v1/shipments/{trackingNumber}/scans - scan history, oldest first
###############################################################################

### v1 200 - scans of the created shipment
GET {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Accept: {{json}}

### v1 404 - unknown shipment
GET {{v1}}/{{unknownShipment}}/scans
Authorization: Bearer {{courierToken}}
Accept: {{json}}

###############################################################################
# v1 DELETE /api/v1/shipments/{trackingNumber} - only while Created
###############################################################################

### v1 409 - PickedUp shipments cannot be deleted
DELETE {{v1}}/{{pickedUpShipment}}
Authorization: Bearer {{adminToken}}

### v1 404 - unknown tracking number
DELETE {{v1}}/{{unknownShipment}}
Authorization: Bearer {{adminToken}}

### v1 204 - create a throw-away shipment, then delete it
# @name throwAwayV1
POST {{v1}}
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-4{{$randomInt 1000000 9999999}}",
  "recipientName": "Lee Example",
  "recipientPhone": "+44 20 7946 0198",
  "recipientAddress": "9 Example Road",
  "recipientCity": "Westfield",
  "weightKg": 1
}

###
DELETE {{v1}}/{{throwAwayV1.response.body.$.trackingNumber}}
Authorization: Bearer {{adminToken}}

