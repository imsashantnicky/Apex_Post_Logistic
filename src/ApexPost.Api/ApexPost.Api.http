# ApexPost shipment tracking API - a success and a failure request for every endpoint, in v1 and v2.
# Start the API first: dotnet run --project src/ApexPost.Api --launch-profile https
# Development seeds APX-20000001 ... APX-20000010 (see API-NOTES.md for their statuses).
# Run each version's requests top to bottom: later requests reuse the shipment created by
# "createShipmentV1" / "createShipmentV2". All data is fictional.
#
# v1 (/api/v1/shipments, alias /api/shipments) is deprecated: flat recipient fields, enums as numbers.
# v2 (/api/v2/shipments) is current: nested "recipient", "latestScan", enums as strings.
# Every answer carries api-supported-versions: 2.0 and api-deprecated-versions: 1.0;
# v1 answers also carry Deprecation, Sunset and Link headers (see VERSIONING.md).

@baseUrl = https://localhost:7310
@v1 = {{baseUrl}}/api/v1/shipments
@v2 = {{baseUrl}}/api/v2/shipments
@json = application/json

# Seeded shipments
@createdShipment = APX-20000001
@pickedUpShipment = APX-20000003
@deliveredShipment = APX-20000008
@unknownShipment = APX-29999999

# Fixed scan ids: the first run stores them, every later run reports them as duplicates.
@repeatedScanIdV1 = scan::0f8fad5b-d9cb-469f-a165-70867728950e
@repeatedScanIdV2 = scan::7c9e6679-7425-40de-944b-e07fc1f90ae7

###############################################################################
# Versioning
###############################################################################

### 200 - the Part B alias /api/shipments is v1 (no version in the URL means 1.0); deprecation headers included
GET {{baseUrl}}/api/shipments/{{createdShipment}}
Accept: {{json}}

### 404 - unknown API version (ProblemDetails)
GET {{baseUrl}}/api/v3/shipments/{{createdShipment}}
Accept: {{json}}

###############################################################################
###############################################################################
# v1 (deprecated) - /api/v1/shipments
###############################################################################
###############################################################################

###############################################################################
# v1 GET /api/v1/shipments - list
###############################################################################

### v1 200 - first page, default page size 20
GET {{v1}}
Accept: {{json}}

### v1 200 - page 1 of 5, only InTransit shipments in Riverton
GET {{v1}}?page=1&pageSize=5&status=InTransit&city=riverton
Accept: {{json}}

### v1 400 - pageSize above the maximum of 50 (ValidationProblemDetails)
GET {{v1}}?pageSize=51
Accept: {{json}}

### v1 400 - unknown status value
GET {{v1}}?status=Lost
Accept: {{json}}

###############################################################################
# v1 POST /api/v1/shipments - create (flat recipient fields)
###############################################################################

### v1 201 - created; the Location header points at GET /api/v1/shipments/{trackingNumber}
# A random tracking number, so this request can run again.
# @name createShipmentV1
POST {{v1}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-3{{$randomInt 1000000 9999999}}",
  "recipientName": "Kim Example",
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "5 Example Street",
  "recipientCity": "Harbour Point",
  "weightKg": 2.5
}

### v1 400 - invalid tracking number, phone and weight (errors per field)
POST {{v1}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-123",
  "recipientName": "",
  "recipientPhone": "call me",
  "recipientAddress": "5 Example Street",
  "recipientCity": "Harbour Point",
  "weightKg": 31
}

### v1 409 - the tracking number already exists
POST {{v1}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "{{createdShipment}}",
  "recipientName": "Kim Example",
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "5 Example Street",
  "recipientCity": "Harbour Point",
  "weightKg": 2.5
}

### v1 415 - the body is not application/json
POST {{v1}}
Content-Type: text/plain
Accept: {{json}}

trackingNumber=APX-30000001

###############################################################################
# v1 GET /api/v1/shipments/{trackingNumber} - read one
###############################################################################

### v1 200 - the shipment just created
GET {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}
Accept: {{json}}

### v1 404 - unknown tracking number
GET {{v1}}/{{unknownShipment}}
Accept: {{json}}

### v1 404 - not APX- + 8 digits, so the route constraint does not match
GET {{v1}}/ABC-1
Accept: {{json}}

###############################################################################
# v1 PUT /api/v1/shipments/{trackingNumber} - replace recipient and weight
###############################################################################

### v1 200 - replaced
PUT {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipientName": "Kim Example",
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "7 Example Street",
  "recipientCity": "Northgate",
  "weightKg": 3
}

### v1 400 - weight below 0.1 kg and name missing
PUT {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "7 Example Street",
  "recipientCity": "Northgate",
  "weightKg": 0
}

### v1 404 - unknown tracking number
PUT {{v1}}/{{unknownShipment}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipientName": "Kim Example",
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "7 Example Street",
  "recipientCity": "Northgate",
  "weightKg": 3
}

### v1 409 - a Delivered shipment can no longer change
PUT {{v1}}/{{deliveredShipment}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipientName": "Hal Specimen",
  "recipientPhone": "+44 20 7946 0108",
  "recipientAddress": "6 Hill Crescent",
  "recipientCity": "Hillcrest",
  "weightKg": 25
}

### v1 415 - wrong content type
PUT {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}
Content-Type: application/xml
Accept: {{json}}

<shipment />

###############################################################################
# v1 PATCH /api/v1/shipments/{trackingNumber}/status - move forward
# v1 sends the status as a number: 1 Created, 2 PickedUp, 3 InTransit, 4 OutForDelivery, 5 Delivered, 6 Failed.
###############################################################################

### v1 400 - status missing
PATCH {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/status
Content-Type: {{json}}
Accept: {{json}}

{}

### v1 404 - unknown tracking number
PATCH {{v1}}/{{unknownShipment}}/status
Content-Type: {{json}}
Accept: {{json}}

{ "status": 2 }

### v1 409 - PickedUp cannot go back to Created
PATCH {{v1}}/{{pickedUpShipment}}/status
Content-Type: {{json}}
Accept: {{json}}

{ "status": 1 }

### v1 409 - Delivered is final
PATCH {{v1}}/{{deliveredShipment}}/status
Content-Type: {{json}}
Accept: {{json}}

{ "status": 6 }

### v1 415 - wrong content type
PATCH {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/status
Content-Type: text/plain
Accept: {{json}}

status=2

###############################################################################
# v1 POST /api/v1/shipments/{trackingNumber}/scans - idempotent scan upload
# scanType as a number: 1 Pickup, 2 InTransit, 3 Delivered, 4 Failed.
# Answer: { accepted, duplicatesSkipped, rejected: [{ scanId, reason }] }
###############################################################################

### v1 200 - first run: accepted 1 (Created -> PickedUp); later runs: duplicatesSkipped 1
POST {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "{{repeatedScanIdV1}}",
      "trackingNumber": "{{createShipmentV1.response.body.$.trackingNumber}}",
      "scanType": 1,
      "courierId": "CR-101",
      "location": "Harbour Point depot",
      "scannedAtUtc": "2026-11-01T08:00:00Z",
      "notes": "Collected at the counter"
    }
  ]
}

### v1 200 - mixed batch: 1 accepted (InTransit), 1 duplicate (repeated scan id), 2 rejected
# (a scan of another shipment, and a later Pickup that would move the status back)
POST {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{createShipmentV1.response.body.$.trackingNumber}}",
      "scanType": 2,
      "courierId": "CR-101",
      "location": "Central hub",
      "scannedAtUtc": "2026-11-01T10:00:00Z"
    },
    {
      "scanId": "{{repeatedScanIdV1}}",
      "trackingNumber": "{{createShipmentV1.response.body.$.trackingNumber}}",
      "scanType": 1,
      "courierId": "CR-101",
      "location": "Harbour Point depot",
      "scannedAtUtc": "2026-11-01T08:00:00Z"
    },
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{createdShipment}}",
      "scanType": 1,
      "courierId": "CR-101",
      "location": "Harbour Point depot",
      "scannedAtUtc": "2026-11-01T10:30:00Z"
    },
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{createShipmentV1.response.body.$.trackingNumber}}",
      "scanType": 1,
      "courierId": "CR-102",
      "location": "Central hub",
      "scannedAtUtc": "2026-11-01T11:00:00Z"
    }
  ]
}

### v1 400 - Delivered scan without recipientSignatureName, scan id not scan::{Guid}, courier id not CR-###
POST {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "123",
      "trackingNumber": "{{createShipmentV1.response.body.$.trackingNumber}}",
      "scanType": 3,
      "courierId": "COURIER-1",
      "location": "Doorstep",
      "scannedAtUtc": "2026-11-01T12:00:00Z"
    }
  ]
}

### v1 400 - empty batch (1 to 100 scans)
POST {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Content-Type: {{json}}
Accept: {{json}}

{ "scans": [] }

### v1 404 - unknown shipment
POST {{v1}}/{{unknownShipment}}/scans
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{unknownShipment}}",
      "scanType": 1,
      "courierId": "CR-101",
      "location": "Harbour Point depot",
      "scannedAtUtc": "2026-11-01T08:00:00Z"
    }
  ]
}

### v1 415 - wrong content type
POST {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Content-Type: text/plain
Accept: {{json}}

scan

###############################################################################
# v1 GET /api/v1/shipments/{trackingNumber}/scans - scan history, oldest first
###############################################################################

### v1 200 - scans of the created shipment
GET {{v1}}/{{createShipmentV1.response.body.$.trackingNumber}}/scans
Accept: {{json}}

### v1 404 - unknown shipment
GET {{v1}}/{{unknownShipment}}/scans
Accept: {{json}}

###############################################################################
# v1 DELETE /api/v1/shipments/{trackingNumber} - only while Created
###############################################################################

### v1 409 - PickedUp shipments cannot be deleted
DELETE {{v1}}/{{pickedUpShipment}}

### v1 404 - unknown tracking number
DELETE {{v1}}/{{unknownShipment}}

### v1 204 - create a throw-away shipment, then delete it
# @name throwAwayV1
POST {{v1}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-4{{$randomInt 1000000 9999999}}",
  "recipientName": "Lee Example",
  "recipientPhone": "+44 20 7946 0198",
  "recipientAddress": "9 Example Road",
  "recipientCity": "Westfield",
  "weightKg": 1
}

###
DELETE {{v1}}/{{throwAwayV1.response.body.$.trackingNumber}}

###############################################################################
###############################################################################
# v2 (current) - /api/v2/shipments
###############################################################################
###############################################################################

###############################################################################
# v2 GET /api/v2/shipments - list (nested recipient, latestScan, status as a string)
###############################################################################

### v2 200 - first page, default page size 20
GET {{v2}}
Accept: {{json}}

### v2 200 - page 1 of 5, only InTransit shipments in Riverton
GET {{v2}}?page=1&pageSize=5&status=InTransit&city=riverton
Accept: {{json}}

### v2 400 - pageSize above the maximum of 50 (ValidationProblemDetails)
GET {{v2}}?pageSize=51
Accept: {{json}}

### v2 400 - page below 1
GET {{v2}}?page=0
Accept: {{json}}

###############################################################################
# v2 POST /api/v2/shipments - create (nested recipient)
###############################################################################

### v2 201 - created; the Location header points at GET /api/v2/shipments/{trackingNumber}
# A random tracking number, so this request can run again. latestScan is null until the first scan.
# @name createShipmentV2
POST {{v2}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-5{{$randomInt 1000000 9999999}}",
  "recipient": {
    "name": "Noah Example",
    "phone": "+44 20 7946 0197",
    "address": "8 Harbour Lane",
    "city": "Harbour Point"
  },
  "weightKg": 2.5
}

### v2 400 - invalid tracking number, nested recipient errors (Recipient.Name, Recipient.Phone) and weight
POST {{v2}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-123",
  "recipient": {
    "name": "",
    "phone": "call me",
    "address": "8 Harbour Lane",
    "city": "Harbour Point"
  },
  "weightKg": 31
}

### v2 400 - the flat v1 body is not a v2 body: recipient is required
POST {{v2}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-50000001",
  "recipientName": "Kim Example",
  "recipientPhone": "+44 20 7946 0199",
  "recipientAddress": "5 Example Street",
  "recipientCity": "Harbour Point",
  "weightKg": 2.5
}

### v2 409 - the tracking number already exists
POST {{v2}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "{{createdShipment}}",
  "recipient": {
    "name": "Noah Example",
    "phone": "+44 20 7946 0197",
    "address": "8 Harbour Lane",
    "city": "Harbour Point"
  },
  "weightKg": 2.5
}

### v2 415 - the body is not application/json
POST {{v2}}
Content-Type: text/plain
Accept: {{json}}

trackingNumber=APX-50000001

###############################################################################
# v2 GET /api/v2/shipments/{trackingNumber} - read one
###############################################################################

### v2 200 - the shipment just created
GET {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}
Accept: {{json}}

### v2 200 - a seeded shipment
GET {{v2}}/{{deliveredShipment}}
Accept: {{json}}

### v2 404 - unknown tracking number
GET {{v2}}/{{unknownShipment}}
Accept: {{json}}

### v2 404 - not APX- + 8 digits, so the route constraint does not match
GET {{v2}}/ABC-1
Accept: {{json}}

###############################################################################
# v2 PUT /api/v2/shipments/{trackingNumber} - replace recipient and weight
###############################################################################

### v2 200 - replaced
PUT {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipient": {
    "name": "Noah Example",
    "phone": "+44 20 7946 0197",
    "address": "10 Harbour Lane",
    "city": "Northgate"
  },
  "weightKg": 3
}

### v2 400 - recipient missing and weight below 0.1 kg
PUT {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}
Content-Type: {{json}}
Accept: {{json}}

{
  "weightKg": 0
}

### v2 404 - unknown tracking number
PUT {{v2}}/{{unknownShipment}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipient": {
    "name": "Noah Example",
    "phone": "+44 20 7946 0197",
    "address": "10 Harbour Lane",
    "city": "Northgate"
  },
  "weightKg": 3
}

### v2 409 - a Delivered shipment can no longer change
PUT {{v2}}/{{deliveredShipment}}
Content-Type: {{json}}
Accept: {{json}}

{
  "recipient": {
    "name": "Hal Specimen",
    "phone": "+44 20 7946 0108",
    "address": "6 Hill Crescent",
    "city": "Hillcrest"
  },
  "weightKg": 25
}

### v2 415 - wrong content type
PUT {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}
Content-Type: application/xml
Accept: {{json}}

<shipment />

###############################################################################
# v2 PATCH /api/v2/shipments/{trackingNumber}/status - move forward
# v2 sends the status as a string: Created, PickedUp, InTransit, OutForDelivery, Delivered, Failed.
###############################################################################

### v2 200 - Created -> OutForDelivery (skipping stages forward is allowed)
PATCH {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/status
Content-Type: {{json}}
Accept: {{json}}

{ "status": "OutForDelivery" }

### v2 400 - unknown status name
PATCH {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/status
Content-Type: {{json}}
Accept: {{json}}

{ "status": "Lost" }

### v2 404 - unknown tracking number
PATCH {{v2}}/{{unknownShipment}}/status
Content-Type: {{json}}
Accept: {{json}}

{ "status": "PickedUp" }

### v2 409 - PickedUp cannot go back to Created
PATCH {{v2}}/{{pickedUpShipment}}/status
Content-Type: {{json}}
Accept: {{json}}

{ "status": "Created" }

### v2 409 - Delivered is final
PATCH {{v2}}/{{deliveredShipment}}/status
Content-Type: {{json}}
Accept: {{json}}

{ "status": "Failed" }

### v2 415 - wrong content type
PATCH {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/status
Content-Type: text/plain
Accept: {{json}}

status=PickedUp

###############################################################################
# v2 POST /api/v2/shipments/{trackingNumber}/scans - idempotent scan upload
# scanType as a string: Pickup, InTransit, Delivered, Failed. Same answer shape as v1.
###############################################################################

### v2 200 - a scan of a seeded InTransit shipment: accepted 1 on the first run, duplicatesSkipped 1 afterwards
POST {{v2}}/APX-20000005/scans
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "{{repeatedScanIdV2}}",
      "trackingNumber": "APX-20000005",
      "scanType": "InTransit",
      "courierId": "CR-102",
      "location": "Southmere hub",
      "scannedAtUtc": "2026-11-01T09:00:00Z",
      "notes": "Second hub scan"
    }
  ]
}

### v2 200 - delivered with a signature: accepted 1, the shipment ends as Delivered; GET it to see latestScan
POST {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/scans
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{createShipmentV2.response.body.$.trackingNumber}}",
      "scanType": "Delivered",
      "courierId": "CR-101",
      "location": "8 Harbour Lane",
      "scannedAtUtc": "2026-11-01T15:00:00Z",
      "recipientSignatureName": "N. Example"
    }
  ]
}

### v2 400 - Delivered scan without recipientSignatureName, scan id not scan::{Guid}, courier id not CR-###
POST {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/scans
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "123",
      "trackingNumber": "{{createShipmentV2.response.body.$.trackingNumber}}",
      "scanType": "Delivered",
      "courierId": "COURIER-1",
      "location": "Doorstep",
      "scannedAtUtc": "2026-11-01T12:00:00Z"
    }
  ]
}

### v2 400 - unknown scanType name
POST {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/scans
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{createShipmentV2.response.body.$.trackingNumber}}",
      "scanType": "Teleported",
      "courierId": "CR-101",
      "location": "Central hub",
      "scannedAtUtc": "2026-11-01T12:00:00Z"
    }
  ]
}

### v2 404 - unknown shipment
POST {{v2}}/{{unknownShipment}}/scans
Content-Type: {{json}}
Accept: {{json}}

{
  "scans": [
    {
      "scanId": "scan::{{$guid}}",
      "trackingNumber": "{{unknownShipment}}",
      "scanType": "Pickup",
      "courierId": "CR-101",
      "location": "Harbour Point depot",
      "scannedAtUtc": "2026-11-01T08:00:00Z"
    }
  ]
}

### v2 415 - wrong content type
POST {{v2}}/{{createShipmentV2.response.body.$.trackingNumber}}/scans
Content-Type: text/plain
Accept: {{json}}

scan

###############################################################################
# v2 GET /api/v2/shipments/{trackingNumber}/scans - scan history, oldest first, scanType as a string
###############################################################################

### v2 200 - scans of a seeded InTransit shipment
GET {{v2}}/APX-20000005/scans
Accept: {{json}}

### v2 404 - unknown shipment
GET {{v2}}/{{unknownShipment}}/scans
Accept: {{json}}

###############################################################################
# v2 DELETE /api/v2/shipments/{trackingNumber} - only while Created
###############################################################################

### v2 409 - PickedUp shipments cannot be deleted
DELETE {{v2}}/{{pickedUpShipment}}

### v2 404 - unknown tracking number
DELETE {{v2}}/{{unknownShipment}}

### v2 204 - create a throw-away shipment, then delete it
# @name throwAwayV2
POST {{v2}}
Content-Type: {{json}}
Accept: {{json}}

{
  "trackingNumber": "APX-6{{$randomInt 1000000 9999999}}",
  "recipient": {
    "name": "Lee Example",
    "phone": "+44 20 7946 0198",
    "address": "9 Example Road",
    "city": "Westfield"
  },
  "weightKg": 1
}

###
DELETE {{v2}}/{{throwAwayV2.response.body.$.trackingNumber}}
