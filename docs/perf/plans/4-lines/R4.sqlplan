<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Shipped AS&#xa;(&#xa;    SELECT shipment.ZoneCode,&#xa;           shipment.Level,&#xa;           shipment.Price,&#xa;           CASE WHEN shipment.WeightGrams / 1000.0&#xa;                     &gt; shipment.LengthCm * shipment.WidthCm * shipment.HeightCm / 5000&#xa;                THEN shipment.WeightGrams / 1000.0&#xa;                ELSE shipment.LengthCm * shipment.WidthCm * shipment.HeightCm / 5000&#xa;           END AS ChargeableKg&#xa;    FROM dbo.Payments AS payment&#xa;    INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = payment.TransactionId&#xa;    INNER JOIN dbo.Shipments AS shipment ON shipment.TransactionId = tx.Id&#xa;    WHERE payment.PaidAt &gt;= CAST(@From AS datetime2)&#xa;      AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xa;      AND tx.Status = &apos;Paid&apos;&#xa;      AND (@BranchCode IS NULL OR tx.BranchCode = @BranchCode)&#xa;)&#xa;SELECT zone.Code AS ZoneCode,&#xa;       zone.Name AS ZoneName,&#xa;       shipped.Level,&#xa;       COUNT(shipped.ZoneCode) AS Shipments,&#xa;       CAST(COALESCE(SUM(shipped.ChargeableKg), 0) AS decimal(18, 2)) AS ChargeableKg,&#xa;       COALESCE(SUM(shipped.Price), 0) AS Revenue&#xa;FROM dbo.ShippingZones AS zone&#xa;LEFT JOIN Shipped AS shipped ON shipped.ZoneCode = zone.Code&#xa;GROUP BY zone.Code, zone.Name, shipped.Level&#xa;HAVING COUNT(shipped.ZoneCode) &gt;= @MinShipments&#xa;ORDER BY zone.Code, shipped.Level option (PLAN PER VALUE(ObjectID = 0, QueryVariantID = 2, optional_predicate(@BranchCode IS NULL)))" StatementId="1" StatementCompId="2" StatementType="SELECT" ParentObjectId="0" StatementSqlHandle="0x0900F478395EF6C77EC342CD4E3A84A8E8B60000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="3.07279" StatementEstRows="30" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xCCD5DE66708BB12D" QueryPlanHash="0x71CCD4D08A4227EE" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><Dispatcher><OptionalParameterPredicate><Predicate><ScalarOperator ScalarString="[@BranchCode] IS NULL"><Compare CompareOp="IS"><ScalarOperator><Identifier><ColumnReference Column="@BranchCode"></ColumnReference></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="NULL"></Const></ScalarOperator></Compare></ScalarOperator></Predicate></OptionalParameterPredicate></Dispatcher><QueryPlan DegreeOfParallelism="1" MemoryGrant="7320" CachedPlanSize="248" CompileTime="39" CompileCPU="39" CompileMemory="2376" QueryVariantID="2"><MissingIndexes><MissingIndexGroup Impact="30.0867"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[CounterTransactions]"><ColumnGroup Usage="EQUALITY"><Column Name="[Status]" ColumnId="6"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="6296" SerialDesiredMemory="7320" RequiredMemory="6296" DesiredMemory="7320" RequestedMemory="7320" GrantWaitTime="0" MaxQueryMemory="3325912" GrantedMemory="7320" MaxUsedMemory="3496" LastRequestedMemory="7320" IsMemoryGrantFeedbackAdjusted="No: Accurate Grant"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="13266544"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-02T09:57:34.73" ModificationCount="6000" SamplingPercent="24.4817" Statistics="[IX_CounterTransactions_ReversalManagerId]