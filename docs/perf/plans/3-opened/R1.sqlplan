<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Baskets AS&#xa;(&#xa;    SELECT tx.Id,&#xa;           tx.BranchCode,&#xa;           CAST(payment.PaidAt AS date) AS SalesDay,&#xa;           payment.Tax,&#xa;           retail.Amount AS Retail,&#xa;           shipping.Amount AS Shipping,&#xa;           moneyOrder.Amount AS MoneyOrders&#xa;    FROM dbo.Payments AS payment&#xa;    INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = payment.TransactionId&#xa;    OUTER APPLY&#xa;    (&#xa;        SELECT SUM(line.UnitPrice * line.Quantity) AS Amount&#xa;        FROM dbo.TransactionLines AS line&#xa;        WHERE line.TransactionId = tx.Id&#xa;    ) AS retail&#xa;    OUTER APPLY&#xa;    (&#xa;        SELECT SUM(shipment.Price) AS Amount&#xa;        FROM dbo.Shipments AS shipment&#xa;        WHERE shipment.TransactionId = tx.Id&#xa;    ) AS shipping&#xa;    OUTER APPLY&#xa;    (&#xa;        SELECT SUM(item.Amount + item.Fee) AS Amount&#xa;        FROM dbo.MoneyOrders AS item&#xa;        WHERE item.TransactionId = tx.Id&#xa;    ) AS moneyOrder&#xa;    WHERE payment.PaidAt &gt;= CAST(@From AS datetime2)&#xa;      AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xa;      AND tx.Status = &apos;Paid&apos;&#xa;      AND (@BranchCode IS NULL OR tx.BranchCode = @BranchCode)&#xa;)&#xa;SELECT baskets.SalesDay,&#xa;       branch.Code AS BranchCode,&#xa;       branch.Name AS BranchName,&#xa;       COUNT(*) AS Transactions,&#xa;       SUM(COALESCE(baskets.Retail, 0)) AS Retail,&#xa;       SUM(COALESCE(baskets.Shipping, 0) + COALESCE(baskets.MoneyOrders, 0)) AS Services,&#xa;       SUM(baskets.Tax) AS Tax&#xa;FROM Baskets AS baskets&#xa;INNER JOIN dbo.Branches AS branch ON branch.Code = baskets.BranchCode&#xa;GROUP BY baskets.SalesDay, branch.Code, branch.Name&#xa;HAVING COUNT(*) &gt;= @MinTransactions&#xa;ORDER BY baskets.SalesDay, branch.Code option (PLAN PER VALUE(ObjectID = 0, QueryVariantID = 2, optional_predicate(@BranchCode IS NULL)))" StatementId="1" StatementCompId="2" StatementType="SELECT" ParentObjectId="0" StatementSqlHandle="0x09004DCFE24D2418CC998152499E0415F4600000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="58.6431" StatementEstRows="1080.51" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xBD75986F29E9D83B" QueryPlanHash="0x7764482E1EA79D49" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><Dispatcher><OptionalParameterPredicate><Predicate><ScalarOperator ScalarString="[@BranchCode] IS NULL"><Compare CompareOp="IS"><ScalarOperator><Identifier><ColumnReference Column="@BranchCode"></ColumnReference></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="NULL"></Const></ScalarOperator></Compare></ScalarOperator></Predicate></OptionalParameterPredicate></Dispatcher><QueryPlan DegreeOfParallelism="1" MemoryGrant="8448" CachedPlanSize="248" CompileTime="38" CompileCPU="38" CompileMemory="2720" QueryVariantID="2"><MemoryGrantInfo SerialRequiredMemory="5272" SerialDesiredMemory="8448" RequiredMemory="5272" DesiredMemory="8448" RequestedMemory="8448" GrantWaitTime="0" MaxQueryMemory="3325912" GrantedMemory="8448" MaxUsedMemory="3344" LastRequestedMemory="8448" IsMemoryGrantFeedbackAdjusted="Yes: Stable"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="13273664"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-02T09:57:12.97" ModificationCount="8000" Sa