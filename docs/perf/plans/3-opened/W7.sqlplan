<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT branch.Code AS BranchCode, branch.Name AS BranchName, branch.Region, COUNT(payment.TransactionId) AS Sales&#xa;FROM dbo.Branches AS branch&#xa;LEFT JOIN dbo.CounterTransactions AS tx&#xa;    ON tx.BranchCode = branch.Code&#xa;   AND tx.Status = &apos;Paid&apos;&#xa;LEFT JOIN dbo.Payments AS payment&#xa;    ON payment.TransactionId = tx.Id&#xa;   AND payment.PaidAt &gt;= CAST(@Day AS datetime2)&#xa;   AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@Day AS datetime2))&#xa;WHERE branch.IsActive = 1&#xa;GROUP BY branch.Code, branch.Name, branch.Region&#xa;HAVING COUNT(payment.TransactionId) = 0&#xa;ORDER BY branch.Code" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900C318868B42352CB17AC52BF4742321790000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="2.27669" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x3AA5AF6BAED3A726" QueryPlanHash="0xF3958E2A3DA7CE39" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="5272" CachedPlanSize="104" CompileTime="21" CompileCPU="21" CompileMemory="1256"><MissingIndexes><MissingIndexGroup Impact="38.3711"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[CounterTransactions]"><ColumnGroup Usage="EQUALITY"><Column Name="[Status]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[BranchCode]" ColumnId="2"