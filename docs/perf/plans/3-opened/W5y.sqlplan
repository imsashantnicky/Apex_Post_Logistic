<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Revenue AS&#xa;(&#xa;    SELECT branch.Region,&#xa;           line.Sku,&#xa;           COALESCE(product.Name, MAX(line.Name)) AS Product,&#xa;           SUM(line.Quantity) AS Units,&#xa;           SUM(line.UnitPrice * line.Quantity) AS Revenue&#xa;    FROM dbo.Payments AS payment&#xa;    INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = payment.TransactionId&#xa;    INNER JOIN dbo.Branches AS branch ON branch.Code = tx.BranchCode&#xa;    INNER JOIN dbo.TransactionLines AS line ON line.TransactionId = tx.Id&#xa;    LEFT JOIN dbo.Products AS product ON product.Sku = line.Sku&#xa;    WHERE payment.PaidAt &gt;= CAST(@From AS datetime2)&#xa;      AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xa;      AND tx.Status = &apos;Paid&apos;&#xa;    GROUP BY branch.Region, line.Sku, product.Name&#xa;    HAVING SUM(line.UnitPrice * line.Quantity) &gt; 0&#xa;),&#xa;Ranked AS&#xa;(&#xa;    SELECT Region, Sku, Product, Units, Revenue,&#xa;           RANK() OVER (PARTITION BY Region ORDER BY Revenue DESC) AS RevenueRank&#xa;    FROM Revenue&#xa;)&#xa;SELECT Region, RevenueRank, Sku, Product, Units, Revenue&#xa;FROM Ranked&#xa;WHERE RevenueRank &lt;= @Top&#xa;ORDER BY Region, RevenueRank, Sku" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900411C8393A32A6CFF2267F33806FE28430000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="14.1606" StatementEstRows="399.244" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xEAA156299EC83A4C" QueryPlanHash="0x073C172CED8A4F8A" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="4" MemoryGrant="39304" CachedPlanSize="272" CompileTime="91" CompileCPU="91" CompileMemory="3752"><ThreadStat Branches="2" UsedThreads="8"><ThreadReservation NodeId="0" ReservedThreads="9"></ThreadReservation></ThreadStat><MemoryGrantInfo SerialRequiredMemory="5432" SerialDesiredMemory="22640" RequiredMemory="22088" DesiredMemory="39304" RequestedMemory="39304" GrantWaitTime="0" MaxQueryMemory="3325912" GrantedMemory="39304" MaxUsedMemory="27904" LastRequestedMemory="36136" IsMemoryGrantFeedbackAdjusted="Yes: Percentile Adjusting"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="13273328"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-02T09:57:12.97" ModificationCount="8000" SamplingPercent="24.4582" Statistics="[IX_CounterTransactions_ReversalManagerId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:57:14.75" ModificationCount="0" SamplingPercent="10.1821" Statistics="[IX_TransactionLines_Sku]" Table="[TransactionLines]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:57:12.90" ModificationCount="8000" SamplingPercent="24.4582" Statistics="[IX_CounterTransactions_CounterId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:57:12.83" ModificationCount="8000" SamplingPercent="24.4582" Statistics="[IX_CounterTransactions_ClerkId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:57:14.03" ModificationCount="0" SamplingPercent