<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Issued AS&#xa;(&#xa;    SELECT tx.BranchCode, COUNT(*) AS MoneyOrders, SUM(item.Amount) AS Amount, SUM(item.Fee) AS Fees&#xa;    FROM dbo.Payments AS payment&#xa;    INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = payment.TransactionId&#xa;    INNER JOIN dbo.MoneyOrders AS item ON item.TransactionId = tx.Id&#xa;    WHERE payment.PaidAt &gt;= CAST(@From AS datetime2)&#xa;      AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xa;      AND tx.Status = &apos;Paid&apos;&#xa;    GROUP BY tx.BranchCode&#xa;),&#xa;Checks AS&#xa;(&#xa;    SELECT tx.BranchCode,&#xa;           SUM(CASE WHEN checked.Result = &apos;Passed&apos; THEN 1 ELSE 0 END) AS Passed,&#xa;           SUM(CASE WHEN checked.Result = &apos;Failed&apos; THEN 1 ELSE 0 END) AS Failed,&#xa;           SUM(CASE WHEN checked.Result = &apos;Pending&apos; THEN 1 ELSE 0 END) AS Pending&#xa;    FROM dbo.IdentityVerifications AS checked&#xa;    INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = checked.TransactionId&#xa;    WHERE checked.VerifiedAt &gt;= CAST(@From AS datetime2)&#xa;      AND checked.VerifiedAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xa;    GROUP BY tx.BranchCode&#xa;)&#xa;SELECT branch.Code AS BranchCode,&#xa;       branch.Name AS BranchName,&#xa;       COALESCE(MAX(issued.MoneyOrders), 0) AS MoneyOrders,&#xa;       COALESCE(MAX(issued.Amount), 0) AS Amount,&#xa;       COALESCE(MAX(issued.Fees), 0) AS Fees,&#xa;       COALESCE(MAX(checks.Passed), 0) AS Passed,&#xa;       COALESCE(MAX(checks.Failed), 0) AS Failed,&#xa;       COALESCE(MAX(checks.Pending), 0) AS Pending&#xa;FROM dbo.Branches AS branch&#xa;LEFT JOIN Issued AS issued ON issued.BranchCode = branch.Code&#xa;LEFT JOIN Checks AS checks ON checks.BranchCode = branch.Code&#xa;GROUP BY branch.Code, branch.Name&#xa;HAVING COALESCE(MAX(issued.MoneyOrders), 0) + COALESCE(MAX(checks.Passed), 0) + COALESCE(MAX(checks.Failed), 0)&#xa;       + COALESCE(MAX(checks.Pending), 0) &gt;= @MinActivity&#xa;ORDER BY branch.Code" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900F438C268F1279DCA4C0D9F8DC61A472E0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="2.6078" StatementEstRows="1.8" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xB9E25F10A38F5DE6" QueryPlanHash="0x0DEBED64B821A60A" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="10736" CachedPlanSize="376" CompileTime="44" CompileCPU="44" CompileMemory="2648"><MissingIndexes><MissingIndexGroup Impact="33.5483"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[CounterTransactions]"><ColumnGroup Usage="EQUALITY"><Column Name="[Status]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[BranchCode]" ColumnId="2"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="8496" SerialDesiredMemory="10736" RequiredMemory="8496" DesiredMemory="10736" RequestedMemory="10736" GrantWaitTime="0" MaxQueryMemory="3334432" GrantedMemory="10736" MaxUsedMemory="4376" LastRequestedMemory="10736" IsMemoryGrantFeedbackAdjusted="No: Accurate Grant"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="13287928"></OptimizerHardwareDependentProperties><OptimizerStats