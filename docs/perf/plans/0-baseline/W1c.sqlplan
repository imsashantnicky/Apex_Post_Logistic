<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Paid AS&#xd;&#xa;    (&#xd;&#xa;        SELECT tx.Id, tx.BranchCode, CAST(payment.PaidAt AS date) AS SalesDay, payment.Tax&#xd;&#xa;        FROM dbo.Payments AS payment&#xd;&#xa;        INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = payment.TransactionId&#xd;&#xa;        WHERE payment.PaidAt &gt;= CAST(@From AS datetime2)&#xd;&#xa;          AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xd;&#xa;          AND tx.Status = &apos;Paid&apos;&#xd;&#xa;          AND (@BranchCode IS NULL OR tx.BranchCode = @BranchCode)&#xd;&#xa;    ),&#xd;&#xa;    Amounts AS&#xd;&#xa;    (&#xd;&#xa;        SELECT line.TransactionId, line.UnitPrice * line.Quantity AS Retail, CAST(0 AS decimal(18, 2)) AS Services&#xd;&#xa;        FROM dbo.TransactionLines AS line&#xd;&#xa;        UNION ALL&#xd;&#xa;        SELECT shipment.TransactionId, 0, shipment.Price&#xd;&#xa;        FROM dbo.Shipments AS shipment&#xd;&#xa;        UNION ALL&#xd;&#xa;        SELECT moneyOrder.TransactionId, 0, moneyOrder.Amount + moneyOrder.Fee&#xd;&#xa;        FROM dbo.MoneyOrders AS moneyOrder&#xd;&#xa;    ),&#xd;&#xa;    Basket AS&#xd;&#xa;    (&#xd;&#xa;        SELECT paid.Id, SUM(amount.Retail) AS Retail, SUM(amount.Services) AS Services&#xd;&#xa;        FROM Paid AS paid&#xd;&#xa;        INNER JOIN Amounts AS amount ON amount.TransactionId = paid.Id&#xd;&#xa;        GROUP BY paid.Id&#xd;&#xa;    )&#xd;&#xa;    SELECT paid.SalesDay,&#xd;&#xa;           paid.BranchCode,&#xd;&#xa;           COUNT(*) AS Transactions,&#xd;&#xa;           CAST(COALESCE(SUM(basket.Retail), 0) AS decimal(18, 2)) AS Retail,&#xd;&#xa;           CAST(COALESCE(SUM(basket.Services), 0) AS decimal(18, 2)) AS Services,&#xd;&#xa;           CAST(SUM(paid.Tax) AS decimal(18, 2)) AS Tax&#xd;&#xa;    FROM Paid AS paid&#xd;&#xa;    LEFT JOIN Basket AS basket ON basket.Id = paid.Id&#xd;&#xa;    GROUP BY paid.SalesDay, paid.BranchCode&#xd;&#xa;    ORDER BY paid.SalesDay, paid.BranchCode option (PLAN PER VALUE(ObjectID = 978102525, QueryVariantID = 1, optional_predicate(@BranchCode IS NULL)))" StatementId="2" StatementCompId="1" StatementType="SELECT" ParentObjectId="978102525" StatementSqlHandle="0x0900F0745E69F43515FC083A5D801FA510370000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="13.4838" StatementEstRows="102.408" SecurityPolicyApplied="false" QueryCompilationReplay="1" StatementOptmLevel="FULL" QueryHash="0x3CDDD42500211021" QueryPlanHash="0x7BB70BA1242B1A3C" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><Dispatcher><OptionalParameterPredicate><Predicate><ScalarOperator ScalarString="[@BranchCode] IS NULL"><Compare CompareOp="IS"><ScalarOperator><Identifier><ColumnReference Column="@BranchCode"></ColumnReference></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="NULL"></Const></ScalarOperator></Compare></ScalarOperator></Predicate></OptionalParameterPredicate></Dispatcher><QueryPlan DegreeOfParallelism="1" MemoryGrant="6296" CachedPlanSize="272" CompileTime="133" CompileCPU="133" CompileMemory="6640" QueryVariantID="1"><MissingIndexes><MissingIndexGroup Impact="31.9517"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[CounterTransactions]"><ColumnGroup Usage="EQUALITY"><Column Name="[BranchCode]" ColumnId="2"></Column><Column Name="[Status]" ColumnId="6"></Column></ColumnGroup></MissingIndex></MissingIndexGroup><MissingIndexGroup Impact="32.0506"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[CounterTransactions]"><ColumnGroup Usage="EQUALITY"><Column Name="[BranchCode]" ColumnId="2"></Column><Column Name="[Status]" ColumnId="6"></Column></ColumnGroup></MissingIndex></MissingIndexGroup><MissingIndexGroup Impact="12.2509"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[Payments]"><ColumnGroup Usage="INEQUALITY"><Column Name="[PaidAt]" ColumnId="2"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[Tax]" ColumnId="4"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="5272" SerialDesiredMemory="6296" RequiredMemory="5272" DesiredMemory="6296" RequestedMemory="6296" GrantWaitTime="0" MaxQueryMemory="3228656" GrantedMemory="6296" MaxUsedMemory="2312" LastRequestedMemory="6296" IsMemoryGrantFeedbackAdjusted="No: Accurate Grant"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="12886112"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-02T09:47:14.30" ModificationCount="0" SamplingPercent="24.8722" Statistics="[IX_CounterTransactions_ReversalManagerId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:13.66" ModificationCount="0" SamplingPercent="54.394" Statistics="[_WA_Sys_00000002_160F4887]" Table="[Payments]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:11.58" ModificationCount="0" SamplingPercent="67.0319" Statistics="[PK_Shipments]" Table="[Shipments]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:11.52" ModificationCount="0" SamplingPercent="10.3622" Statistics="[IX_TransactionLines_Sku]" Table="[TransactionLines]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></Statistics