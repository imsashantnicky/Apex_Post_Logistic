<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT branch.Code AS BranchCode, branch.Name AS BranchName, branch.Region, COUNT(payment.TransactionId) AS Sales&#xa;FROM dbo.Branches AS branch&#xa;LEFT JOIN dbo.CounterTransactions AS tx&#xa;    ON tx.BranchCode = branch.Code&#xa;   AND tx.Status = &apos;Paid&apos;&#xa;LEFT JOIN dbo.Payments AS payment&#xa;    ON payment.TransactionId = tx.Id&#xa;   AND payment.PaidAt &gt;= CAST(@Day AS datetime2)&#xa;   AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@Day AS datetime2))&#xa;WHERE branch.IsActive = 1&#xa;GROUP BY branch.Code, branch.Name, branch.Region&#xa;HAVING COUNT(payment.TransactionId) = 0&#xa;ORDER BY branch.Code" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900C318868B42352CB17AC52BF4742321790000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="6.15295" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x3AA5AF6BAED3A726" QueryPlanHash="0xA570AB1CE549E4BC" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="4" MemoryGrant="22184" CachedPlanSize="144" CompileTime="43" CompileCPU="43" CompileMemory="1936"><ThreadStat Branches="1" UsedThreads="4"><ThreadReservation NodeId="0" ReservedThreads="5"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="64.5722"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[CounterTransactions]"><ColumnGroup Usage="EQUALITY"><Column Name="[Status]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[BranchCode]" ColumnId="2"></Column></ColumnGroup></MissingIndex></MissingIndexGroup><MissingIndexGroup Impact="24.6764"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[Payments]"><ColumnGroup Usage="INEQUALITY"><Column Name="[PaidAt]" ColumnId="2"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="5272" SerialDesiredMemory="6296" RequiredMemory="21160" DesiredMemory="22184" RequestedMemory="22184" GrantWaitTime="0" MaxQueryMemory="3228656" GrantedMemory="22184" MaxUsedMemory="3232" LastRequestedMemory="22184" IsMemoryGrantFeedbackAdjusted="Yes: Stable"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="12882240"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-02T09:47:14.30" ModificationCount="0" SamplingPercent="24.8722" Statistics="[IX_CounterTransactions_ReversalManagerId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:13.66" ModificationCount="0" SamplingPercent="54.394" Statistics="[_WA_Sys_00000002_160F4887]" Table="[Payments]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-01T23:00:52.92" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000006_5070F446]" Table="[Branches]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:14.23" ModificationCount="0" SamplingPercent="24.8722" Statistics="[IX_CounterTransactions_CounterId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:14.16" ModificationCount="0" Sampling