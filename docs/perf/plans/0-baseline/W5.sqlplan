<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Revenue AS&#xa;(&#xa;    SELECT branch.Region,&#xa;           line.Sku,&#xa;           COALESCE(product.Name, MAX(line.Name)) AS Product,&#xa;           SUM(line.Quantity) AS Units,&#xa;           SUM(line.UnitPrice * line.Quantity) AS Revenue&#xa;    FROM dbo.Payments AS payment&#xa;    INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = payment.TransactionId&#xa;    INNER JOIN dbo.Branches AS branch ON branch.Code = tx.BranchCode&#xa;    INNER JOIN dbo.TransactionLines AS line ON line.TransactionId = tx.Id&#xa;    LEFT JOIN dbo.Products AS product ON product.Sku = line.Sku&#xa;    WHERE payment.PaidAt &gt;= CAST(@From AS datetime2)&#xa;      AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xa;      AND tx.Status = &apos;Paid&apos;&#xa;    GROUP BY branch.Region, line.Sku, product.Name&#xa;    HAVING SUM(line.UnitPrice * line.Quantity) &gt; 0&#xa;),&#xa;Ranked AS&#xa;(&#xa;    SELECT Region, Sku, Product, Units, Revenue,&#xa;           RANK() OVER (PARTITION BY Region ORDER BY Revenue DESC) AS RevenueRank&#xa;    FROM Revenue&#xa;)&#xa;SELECT Region, RevenueRank, Sku, Product, Units, Revenue&#xa;FROM Ranked&#xa;WHERE RevenueRank &lt;= @Top&#xa;ORDER BY Region, RevenueRank, Sku" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900411C8393A32A6CFF2267F33806FE28430000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="18.6927" StatementEstRows="399.03" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xEAA156299EC83A4C" QueryPlanHash="0x17C04A8AC7E84723" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="4" MemoryGrant="25160" CachedPlanSize="272" CompileTime="95" CompileCPU="95" CompileMemory="3760"><ThreadStat Branches="2" UsedThreads="8"><ThreadReservation NodeId="0" ReservedThreads="9"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="21.2542"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[CounterTransactions]"><ColumnGroup Usage="EQUALITY"><Column Name="[Status]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[BranchCode]" ColumnId="2"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="5432" SerialDesiredMemory="8504" RequiredMemory="22088" DesiredMemory="25160" RequestedMemory="25160" GrantWaitTime="0" MaxQueryMemory="3228656" GrantedMemory="25160" MaxUsedMemory="7040" LastRequestedMemory="25160" IsMemoryGrantFeedbackAdjusted="Yes: Stable"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="12882872"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-02T09:47:14.30" ModificationCount="0" SamplingPercent="24.8722" Statistics="[IX_CounterTransactions_ReversalManagerId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:13.66" ModificationCount="0" SamplingPercent="54.394" Statistics="[_WA_Sys_00000002_160F4887]" Table="[Payments]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:11.52" ModificationCount="0" SamplingPercent="10.3622" Statistics="[IX_TransactionLines_Sku]" Table="[TransactionLines]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsI