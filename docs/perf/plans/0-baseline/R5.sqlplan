<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Issued AS&#xa;(&#xa;    SELECT tx.BranchCode, COUNT(*) AS MoneyOrders, SUM(item.Amount) AS Amount, SUM(item.Fee) AS Fees&#xa;    FROM dbo.Payments AS payment&#xa;    INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = payment.TransactionId&#xa;    INNER JOIN dbo.MoneyOrders AS item ON item.TransactionId = tx.Id&#xa;    WHERE payment.PaidAt &gt;= CAST(@From AS datetime2)&#xa;      AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xa;      AND tx.Status = &apos;Paid&apos;&#xa;    GROUP BY tx.BranchCode&#xa;),&#xa;Checks AS&#xa;(&#xa;    SELECT tx.BranchCode,&#xa;           SUM(CASE WHEN checked.Result = &apos;Passed&apos; THEN 1 ELSE 0 END) AS Passed,&#xa;           SUM(CASE WHEN checked.Result = &apos;Failed&apos; THEN 1 ELSE 0 END) AS Failed,&#xa;           SUM(CASE WHEN checked.Result = &apos;Pending&apos; THEN 1 ELSE 0 END) AS Pending&#xa;    FROM dbo.IdentityVerifications AS checked&#xa;    INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = checked.TransactionId&#xa;    WHERE checked.VerifiedAt &gt;= CAST(@From AS datetime2)&#xa;      AND checked.VerifiedAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xa;    GROUP BY tx.BranchCode&#xa;)&#xa;SELECT branch.Code AS BranchCode,&#xa;       branch.Name AS BranchName,&#xa;       COALESCE(MAX(issued.MoneyOrders), 0) AS MoneyOrders,&#xa;       COALESCE(MAX(issued.Amount), 0) AS Amount,&#xa;       COALESCE(MAX(issued.Fees), 0) AS Fees,&#xa;       COALESCE(MAX(checks.Passed), 0) AS Passed,&#xa;       COALESCE(MAX(checks.Failed), 0) AS Failed,&#xa;       COALESCE(MAX(checks.Pending), 0) AS Pending&#xa;FROM dbo.Branches AS branch&#xa;LEFT JOIN Issued AS issued ON issued.BranchCode = branch.Code&#xa;LEFT JOIN Checks AS checks ON checks.BranchCode = branch.Code&#xa;GROUP BY branch.Code, branch.Name&#xa;HAVING COALESCE(MAX(issued.MoneyOrders), 0) + COALESCE(MAX(checks.Passed), 0) + COALESCE(MAX(checks.Failed), 0)&#xa;       + COALESCE(MAX(checks.Pending), 0) &gt;= @MinActivity&#xa;ORDER BY branch.Code" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900F438C268F1279DCA4C0D9F8DC61A472E0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="7.15768" StatementEstRows="1.8" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xB9E25F10A38F5DE6" QueryPlanHash="0x2D597B7274F04A17" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="4" MemoryGrant="46824" CachedPlanSize="400" CompileTime="107" CompileCPU="107" CompileMemory="4872"><ThreadStat Branches="1" UsedThreads="4"><ThreadReservation NodeId="0" ReservedThreads="5"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="55.5067"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[CounterTransactions]"><ColumnGroup Usage="EQUALITY"><Column Name="[Status]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[BranchCode]" ColumnId="2"></Column></ColumnGroup></MissingIndex></MissingIndexGroup><MissingIndexGroup Impact="21.2126"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[Payments]"><ColumnGroup Usage="INEQUALITY"><Column Name="[PaidAt]" ColumnId="2"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="11416" SerialDesiredMemory="12504" RequiredMemory="45736" DesiredMemory="46824" RequestedMemory="46824" GrantWaitTime="0" MaxQueryMemory="3228656" GrantedMemory="46824" MaxUsedMemory="5376" LastRequestedMemory="46824" IsMemoryGrantFeedbackAdjusted="Yes: Stable"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="12880528"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-02T09:47:14.30" ModificationCount="0" SamplingPercent="24.8722" Statistics="[IX_CounterTransactions_ReversalManagerId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:13.66" ModificationCount="0" SamplingPercent="54.394" Statistics="[_WA_Sys_00000002_160F4887]" Table="[Payments]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:55:02.85" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000006_0A9D95DB]" Table="[IdentityVerifications]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:14.23" ModificationCount="0" SamplingPercent="24.8722" Statistics="[IX_CounterTransactions_CounterId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:14.16" ModificationCount="0" SamplingPercent="24.8722" Statistics="[IX_CounterTransactions_ClerkId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:13.54" ModificationCount="0" SamplingPercent="100" Statistics="[IX_MoneyOrders_TransactionId]" Table="[MoneyOrders]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:14.09" ModificationCount="0" SamplingPercent="24.8722" Statistics="[IX_CounterTransactions_BranchCode]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:13.97" ModificationCount="0" SamplingPercent="100" Statistics="[PK_Branches]" Table="[Branches]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:14.37" ModificationCount="0" SamplingPercent="24.8722" Statistics="[_WA_Sys_00000006_7A672E12]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:46:58.08" ModificationCount="0" SamplingPercent="23.6921" Statistics="[PK_CounterTransactions]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:13.50" ModificationCount="0" SamplingPercent="100" Statistics="[IX_IdentityVerifications_TransactionId]" Table="[IdentityVerifications]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:47:13.61" ModificationCount="0" SamplingPercent="54.394" Statistics="[PK_Payments]" Table="[Payments]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo></OptimizerStatsUsage><WaitStats><Wait WaitType="CXSYNC_PORT" WaitTimeMs="51" WaitCount="5"></Wait><Wait WaitType="BMPBUILD" WaitTimeMs="23" WaitCount="12"></Wait><Wait WaitType="HTREPARTITION" WaitTimeMs="23" WaitCount="30"></Wait><Wait WaitType="EXECSYNC" WaitTimeMs="16" WaitCount="68"></Wait><Wait WaitType="LATCH_EX" WaitTimeMs="3" WaitCount="21"></Wait><Wait WaitType="BPSORT" WaitTimeMs="2" WaitCount="74"></Wait><Wait WaitType="HTDELETE_JOIN" WaitTimeMs="2" WaitCount="24"></Wait><Wait WaitType="RESERVED_MEMORY_ALLOCATION_EXT" WaitTimeMs="1" WaitCount="745"></Wait></WaitStats><QueryTimeStats ElapsedTime="51" CpuTime="131"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Parallelism" LogicalOp="Gather Streams" EstimateRows="1.8" EstimateIO="0" EstimateCPU="0.0285261" AvgRowSize="168" EstimatedTotalSubtreeCost="7.15768" Parallel="1" EstimateRebinds="0" EstimateRewinds="0"