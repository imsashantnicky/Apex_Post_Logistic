<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Paid AS&#xa;(&#xa;    SELECT tx.Id, tx.BranchCode, CAST(payment.PaidAt AS date) AS SalesDay, payment.Tax&#xa;    FROM dbo.Payments AS payment&#xa;    INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = payment.TransactionId&#xa;    WHERE payment.PaidAt &gt;= CAST(@From AS datetime2)&#xa;      AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xa;      AND tx.Status = &apos;Paid&apos;&#xa;      AND (@BranchCode IS NULL OR tx.BranchCode = @BranchCode)&#xa;),&#xa;Retail AS&#xa;(&#xa;    SELECT line.TransactionId, SUM(line.UnitPrice * line.Quantity) AS Amount&#xa;    FROM dbo.TransactionLines AS line&#xa;    INNER JOIN Paid AS paid ON paid.Id = line.TransactionId&#xa;    GROUP BY line.TransactionId&#xa;),&#xa;Shipping AS&#xa;(&#xa;    SELECT shipment.TransactionId, SUM(shipment.Price) AS Amount&#xa;    FROM dbo.Shipments AS shipment&#xa;    INNER JOIN Paid AS paid ON paid.Id = shipment.TransactionId&#xa;    GROUP BY shipment.TransactionId&#xa;),&#xa;Orders AS&#xa;(&#xa;    SELECT item.TransactionId, SUM(item.Amount + item.Fee) AS Amount&#xa;    FROM dbo.MoneyOrders AS item&#xa;    INNER JOIN Paid AS paid ON paid.Id = item.TransactionId&#xa;    GROUP BY item.TransactionId&#xa;)&#xa;SELECT paid.SalesDay,&#xa;       branch.Code AS BranchCode,&#xa;       branch.Name AS BranchName,&#xa;       COUNT(*) AS Transactions,&#xa;       SUM(COALESCE(retail.Amount, 0)) AS Retail,&#xa;       SUM(COALESCE(shipping.Amount, 0) + COALESCE(orders.Amount, 0)) AS Services,&#xa;       SUM(paid.Tax) AS Tax&#xa;FROM Paid AS paid&#xa;INNER JOIN dbo.Branches AS branch ON branch.Code = paid.BranchCode&#xa;LEFT JOIN Retail AS retail ON retail.TransactionId = paid.Id&#xa;LEFT JOIN Shipping AS shipping ON shipping.TransactionId = paid.Id&#xa;LEFT JOIN Orders AS orders ON orders.TransactionId = paid.Id&#xa;GROUP BY paid.SalesDay, branch.Code, branch.Name&#xa;HAVING COUNT(*) &gt;= @MinTransactions&#xa;ORDER BY paid.SalesDay, branch.Code option (PLAN PER VALUE(ObjectID = 0, QueryVariantID = 2, optional_predicate(@BranchCode IS NULL)))" StatementId="1" StatementCompId="2" StatementType="SELECT" ParentObjectId="0" StatementSqlHandle="0x0900C8B89F95C78EC16FC52F8868EB4346440000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="18.2339" StatementEstRows="1522.91" SecurityPolicyApplied="false" QueryCompilationReplay="1" StatementOptmLevel="FULL" QueryHash="0x7EED3B36CEA6EC8B" QueryPlanHash="0xC9AE01C5D8DE4D08" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><Dispatcher><OptionalParameterPredicate><Predicate><ScalarOperator ScalarString="[@BranchCode] IS NULL"><Compare CompareOp="IS"><ScalarOperator><Identifier><ColumnReference Column="@BranchCode"></ColumnReference></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="NULL"></Const></ScalarOperator></Compare></ScalarOperator></Predicate></OptionalParameterPredicate></Dispatcher><QueryPlan DegreeOfParallelism="4" MemoryGrant="95912" CachedPlanSize="736" CompileTime="332" CompileCPU="332" CompileMemory="12096" QueryVariantID="2"><ThreadStat Branches="1" UsedThreads="4"><ThreadReservation NodeId="0" ReservedThreads="5"></ThreadReservation></ThreadStat><MemoryGrantInfo SerialRequiredMemory="23704" SerialDesiredMemory="24728" RequiredMemory="94888" DesiredMemory="95912" RequestedMemory="95912" GrantWaitTime="0" MaxQueryMemory="3325912" GrantedMemory="95912" MaxUsedMemory="11776" LastRequestedMemory="95912" IsMemoryGrantFeedbackAdjusted="Yes: Stable"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="13274480"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-02T10:00:03.64" ModificationCount="12000" SamplingPercent="24.4677" Statistics="[IX_CounterTransactions_ReversalManagerId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T10:00:06.45" ModificationCount="0" SamplingPercent="65.06" Statistics="[PK_Shipments]" Table="[Shipments]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T10:00:06.29" ModificationCount="0" SamplingPercent="10.5664" Statistics="[IX_TransactionLines_Sku]" Table="[TransactionLines]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T10:00:03.58" ModificationCount="12000" SamplingPercent="24.4677" Statistics="[IX_CounterTransactions_CounterId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T10:00:03.50" ModificationCount="12000" SamplingPercent="24.4677" Statistics="[IX_CounterTransactions_ClerkId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T10:00:09.15" ModificationCount="0" SamplingPercent="100" Statistics="[IX_MoneyOrders_TransactionId]" Table="[MoneyOrders]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T10:00:04.70" ModificationCount="4000" SamplingPercent="24.3129" Statistics="[IX_CounterTransactions_OpenedAt]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T10:00:05.04" ModificationCount="2000" SamplingPercent="25.0809" Statistics="[