<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Paid AS&#xd;&#xa;    (&#xd;&#xa;        SELECT tx.Id, tx.BranchCode, CAST(payment.PaidAt AS date) AS SalesDay, payment.Tax&#xd;&#xa;        FROM dbo.Payments AS payment&#xd;&#xa;        INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = payment.TransactionId&#xd;&#xa;        WHERE payment.PaidAt &gt;= CAST(@From AS datetime2)&#xd;&#xa;          AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xd;&#xa;          AND tx.Status = &apos;Paid&apos;&#xd;&#xa;          AND (@BranchCode IS NULL OR tx.BranchCode = @BranchCode)&#xd;&#xa;    ),&#xd;&#xa;    Amounts AS&#xd;&#xa;    (&#xd;&#xa;        SELECT line.TransactionId, line.UnitPrice * line.Quantity AS Retail, CAST(0 AS decimal(18, 2)) AS Services&#xd;&#xa;        FROM dbo.TransactionLines AS line&#xd;&#xa;        UNION ALL&#xd;&#xa;        SELECT shipment.TransactionId, 0, shipment.Price&#xd;&#xa;        FROM dbo.Shipments AS shipment&#xd;&#xa;        UNION ALL&#xd;&#xa;        SELECT moneyOrder.TransactionId, 0, moneyOrder.Amount + moneyOrder.Fee&#xd;&#xa;        FROM dbo.MoneyOrders AS moneyOrder&#xd;&#xa;    ),&#xd;&#xa;    Basket AS&#xd;&#xa;    (&#xd;&#xa;        SELECT paid.Id, SUM(amount.Retail) AS Retail, SUM(amount.Services) AS Services&#xd;&#xa;        FROM Paid AS paid&#xd;&#xa;        INNER JOIN Amounts AS amount ON amount.TransactionId = paid.Id&#xd;&#xa;        GROUP BY paid.Id&#xd;&#xa;    )&#xd;&#xa;    SELECT paid.SalesDay,&#xd;&#xa;           paid.BranchCode,&#xd;&#xa;           COUNT(*) AS Transactions,&#xd;&#xa;           CAST(COALESCE(SUM(basket.Retail), 0) AS decimal(18, 2)) AS Retail,&#xd;&#xa;           CAST(COALESCE(SUM(basket.Services), 0) AS decimal(18, 2)) AS Services,&#xd;&#xa;           CAST(SUM(paid.Tax) AS decimal(18, 2)) AS Tax&#xd;&#xa;    FROM Paid AS paid&#xd;&#xa;    LEFT JOIN Basket AS basket ON basket.Id = paid.Id&#xd;&#xa;    GROUP BY paid.SalesDay, paid.BranchCode&#xd;&#xa;    ORDER BY paid.SalesDay, paid.BranchCode option (PLAN PER VALUE(ObjectID = 978102525, QueryVariantID = 2, optional_predicate(@BranchCode IS NULL)))" StatementId="2" StatementCompId="14" StatementType="SELECT" ParentObjectId="978102525" StatementSqlHandle="0x0900E7D7300D009F5FB6063C99F0F08264CB0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="7.49442" StatementEstRows="1372.01" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x3CDDD42500211021" QueryPlanHash="0xFBC020038C4BB8B5" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><Dispatcher><OptionalParameterPredicate><Predicate><ScalarOperator ScalarString="[@BranchCode] IS NULL"><Compare CompareOp="IS"><ScalarOperator><Identifier><ColumnReference Column="@BranchCode"></ColumnReference></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="NULL"></Const></ScalarOperator></Compare></ScalarOperator></Predicate></OptionalParameterPredicate></Dispatcher><QueryPlan DegreeOfParallelism="1" MemoryGrant="7984" CachedPlanSize="304" CompileTime="87" CompileCPU="87" CompileMemory="4824" QueryVariantID="2"><MissingIndexes><MissingIndexGroup Impact="11.8318"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[CounterTransactions]"><ColumnGroup Usage="EQUALITY"><Column Name="[Status]" ColumnId="6"></Column></ColumnGroup></MissingIndex></MissingIndexGroup><MissingIndexGroup Impact="11.733"><MissingIndex Database="[ApexPostDb_Perf]" Schema="[dbo]" Table="[CounterTransactions]"><ColumnGroup Usage="EQUALITY"><Column Name="[Status]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[BranchCode]" ColumnId="2"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="6296" SerialDesiredMemory="7984" RequiredMemory="6296" DesiredMemory="7984" RequestedMemory="7984" GrantWaitTime="0" MaxQueryMemory="3325912" GrantedMemory="7984" MaxUsedMemory="4552" LastRequestedMemory="7984" IsMemoryGrantFeedbackAdjusted="Yes: Stable"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="13277144"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-02T09:58:05.77" ModificationCount="2000" SamplingPercent="24.4747" Statistics="[IX_CounterTransactions_ReversalManagerId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:57:52.64" ModificationCount="3500" SamplingPercent="65.4392" Statistics="[PK_Shipments]" Table="[Shipments]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:58:06.67" ModificationCount="0" SamplingPercent="10.2611" Statistics="[IX_TransactionLines_Sku]" Table="[TransactionLines]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:58:05.71" ModificationCount="2000" SamplingPercent="24.4747" Statistics="[IX_CounterTransactions_CounterId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:58:05.63" ModificationCount="2000" SamplingPercent="24.4747" Statistics="[IX_CounterTransactions_ClerkId]" Table="[CounterTransactions]" Schema="[dbo]" Database="[ApexPostDb_Perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-02T09:58:06.18" ModificationCount="0" SamplingPercent="100" 