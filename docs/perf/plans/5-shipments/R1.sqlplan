<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH Baskets AS&#xa;(&#xa;    SELECT tx.Id,&#xa;           tx.BranchCode,&#xa;           CAST(payment.PaidAt AS date) AS SalesDay,&#xa;           payment.Tax,&#xa;           retail.Amount AS Retail,&#xa;           shipping.Amount AS Shipping,&#xa;           moneyOrder.Amount AS MoneyOrders&#xa;    FROM dbo.Payments AS payment&#xa;    INNER JOIN dbo.CounterTransactions AS tx ON tx.Id = payment.TransactionId&#xa;    OUTER APPLY&#xa;    (&#xa;        SELECT SUM(line.UnitPrice * line.Quantity) AS Amount&#xa;        FROM dbo.TransactionLines AS line&#xa;        WHERE line.TransactionId = tx.Id&#xa;    ) AS retail&#xa;    OUTER APPLY&#xa;    (&#xa;        SELECT SUM(shipment.Price) AS Amount&#xa;        FROM dbo.Shipments AS shipment&#xa;        WHERE shipment.TransactionId = tx.Id&#xa;    ) AS shipping&#xa;    OUTER APPLY&#xa;    (&#xa;        SELECT SUM(item.Amount + item.Fee) AS Amount&#xa;        FROM dbo.MoneyOrders AS item&#xa;        WHERE item.TransactionId = tx.Id&#xa;    ) AS moneyOrder&#xa;    WHERE payment.PaidAt &gt;= CAST(@From AS datetime2)&#xa;      AND payment.PaidAt &lt; DATEADD(DAY, 1, CAST(@To AS datetime2))&#xa;      AND tx.Status = &apos;Paid&apos;&#xa;      AND (@BranchCode IS NULL OR tx.BranchCode = @BranchCode)&#xa;)&#xa;SELECT baskets.SalesDay,&#xa;       branch.Code AS BranchCode,&#xa;       branch.Name AS BranchName,&#xa;       COUNT(*) AS Transactions,&#xa;       SUM(COALESCE(baskets.Retail, 0)) AS Retail,&#xa;       SUM(COALESCE(baskets.Shipping, 0) + COALESCE(baskets.MoneyOrders, 0)) AS Services,&#xa;       SUM(baskets.Tax) AS Tax&#xa;FROM Baskets AS baskets&#xa;INNER JOIN dbo.Branches AS branch ON branch.Code = baskets.BranchCode&#xa;GROUP BY baskets.SalesDay, branch.Code, branch.Name&#xa;HAVING COUNT(*) &gt;= @MinTransactions&#xa;ORDER BY baskets.SalesDay, branch.Code option (PLAN PER VALUE(ObjectID = 0, QueryVariantID = 2, optional_predicate(@BranchCode IS NULL)))" StatementId="1" StatementCompId="2" StatementType="SELECT" ParentObjectId="0" StatementSqlHandle="0x09004DCFE24D2418CC998152499E0415F4600000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="23.949" StatementEstRows="1371.94" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xBD75986F29E9D83B" QueryPlanHash="0xF2521A8A7FC09DF9" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><Dispatcher><OptionalParameterPredicate><Predicate><ScalarOperator ScalarString="[@BranchCode] IS NULL"><Compare CompareOp="IS"><ScalarOperator><Identifier><ColumnReference Column="@BranchCode"></ColumnReference></Identifier></ScalarOperator><ScalarOperator><Const ConstValue="NULL"></Const></ScalarOperator></Compare></ScalarOperator></Predicate></OptionalParameterPredicate></Dispatcher><QueryPlan DegreeOfParallelism="4" MemoryGrant="23208" CachedPlanSize="256" CompileTime="50" CompileCPU="50" CompileMemory="3400" QueryVariantID="2"><ThreadStat Branches="1" UsedThreads="4"><ThreadReservation NodeId="0" ReservedThreads="5"></ThreadReservation></ThreadStat><MemoryGrantInfo SerialRequiredMemory="5272" SerialDesiredMemory="7320" RequiredMemory="21160" DesiredMemory="23208" RequestedMemory="23208" GrantWaitTime="0" MaxQueryMemory="3325912" GrantedMemory="23208" MaxUsedMemory="4800" LastRequestedMemory="23208" IsMemoryGrantFeedbackAdjusted="Yes: Stable"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="838835" EstimatedPagesCached="209708" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="13272496"></Optimize