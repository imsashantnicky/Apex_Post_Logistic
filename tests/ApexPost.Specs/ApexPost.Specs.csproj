<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ShipmentCreation.feature drives the real API host (WebApplicationFactory). -->
    <ProjectReference Include="..\..\src\ApexPost.Api\ApexPost.Api.csproj" />
    <!-- ScanSync.feature drives the real Couchbase outbox on the courier side. -->
    <ProjectReference Include="..\..\src\Courier\ApexPost.Courier.Offline\ApexPost.Courier.Offline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One shared SQL Server lookup for every SQL fixture (TESTING-STRATEGY.md section 6). -->
    <Compile Include="..\Common\SqlTestServer.cs" Link="Support\SqlTestServer.cs" />
    <!-- The stateful in-memory tracking repositories of the service tests, reused as the ScanSync server. -->
    <Compile Include="..\ApexPost.Tracking.UnitTests\Support\InMemoryTracking.cs" Link="Support\InMemoryTracking.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
  </ItemGroup>

</Project>
