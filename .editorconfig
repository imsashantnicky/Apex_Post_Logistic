root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{json,xml,csproj,props,slnx,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Test method names use underscores (Given_When_Then style), so CA1707 is turned off for tests only.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core writes the migrations, so analyzers skip them as generated code.
[src/ApexPost.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true
